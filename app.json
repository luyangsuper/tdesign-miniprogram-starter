{
  "pages": [
    "pages/home/index",
    "pages/my/index"
  ],
  "subpackages": [
    {
      "root": "pages/admin",
      "name": "admin",
      "pages": [
        "upload/index",
        "categories/index",
        "codes/index",
        "users/index",
        "points/index",
        "pricing/index",
        "lottery/index",
        "dashboard/index"
      ]
    },
    {
      "root": "pages/pack",
      "name": "pack",
      "pages": ["detail/index"]
    },
    {
      "root": "pages/lottery",
      "name": "lottery",
      "pages": ["index/index", "detail/index"]
    },
    {
      "root": "pages/history",
      "name": "history",
      "pages": ["points-log/index", "favorites/index"]
    },
    {
      "root": "pages/about",
      "name": "about",
      "pages": ["index"]
    }
  ],
  "darkmode": true,
  "themeLocation": "theme.json",
  "window": {
    "backgroundTextStyle": "@bgTextStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTitleText": "趣图铺子",
    "navigationBarTextStyle": "@navTextStyle",
    "navigationStyle": "custom",
    "backgroundColor": "@bgColor"
  },
  "tabBar": {
    "custom": true,
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/my/index",
        "text": "我的"
      }
    ]
  },
  "usingComponents": {
    "kubai-icon": "/components/kubai-icon/index"
  },
  "resolveAlias": {
    "~/*": "/*"
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
