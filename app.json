{
  "pages": [
    "pages/home/index",
    "pages/my/index",
    "pages/admin/upload/index",
    "pages/admin/categories/index",
    "pages/admin/codes/index",
    "pages/admin/users/index",
    "pages/admin/points/index",
    "pages/admin/pricing/index",
    "pages/admin/lottery/index",
    "pages/admin/dashboard/index"
  ],
  "subpackages": [
    {
      "root": "pages/pack",
      "name": "pack",
      "pages": ["detail/index"]
    },
    {
      "root": "pages/lottery",
      "name": "lottery",
      "pages": ["index/index", "detail/index"]
    },
    {
      "root": "pages/history",
      "name": "history",
      "pages": ["points-log/index", "favorites/index"]
    },
    {
      "root": "pages/about",
      "name": "about",
      "pages": ["index"]
    }
  ],
  "darkmode": true,
  "themeLocation": "theme.json",
  "window": {
    "backgroundTextStyle": "@bgTextStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTitleText": "趣集",
    "navigationBarTextStyle": "@navTextStyle",
    "navigationStyle": "custom",
    "backgroundColor": "@bgColor"
  },
  "tabBar": {
    "custom": true,
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/my/index",
        "text": "我的"
      }
    ]
  },
  "resolveAlias": {
    "~/*": "/*"
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
