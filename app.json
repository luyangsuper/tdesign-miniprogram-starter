{
  "pages": ["pages/home/index", "pages/my/index"],
  "subpackages": [
    {
      "root": "pages/pack",
      "name": "pack",
      "pages": ["detail/index"]
    },
    {
      "root": "pages/lottery",
      "name": "lottery",
      "pages": ["index/index", "detail/index"]
    },
    {
      "root": "pages/admin",
      "name": "admin",
      "pages": [
        "upload/index",
        "categories/index",
        "codes/index",
        "users/index",
        "points/index",
        "lottery/index"
      ]
    }
  ],
  "darkmode": true,
  "themeLocation": "theme.json",
  "window": {
    "backgroundTextStyle": "@bgTextStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTitleText": "趣集",
    "navigationBarTextStyle": "@navTextStyle",
    "backgroundColor": "@bgColor"
  },
  "tabBar": {
    "custom": true,
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/my/index",
        "text": "我的"
      }
    ]
  },
  "usingComponents": {
    "lottery-host": "/components/lottery-host/index"
  },
  "resolveAlias": {
    "~/*": "/*"
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
