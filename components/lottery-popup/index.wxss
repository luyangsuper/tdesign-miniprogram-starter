.ltp {
  width: 620rpx;
  max-width: 90vw;
  margin: 0 24rpx;
  padding: 36rpx 24rpx 28rpx;
  border-radius: 24rpx;
  background: var(--td-bg-color-container);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: var(--td-text-color-primary);
}
.ltp__reveal-slot {
  width: 0;
  height: 0;
  overflow: hidden;
}
.ltp__icon-wrap {
  margin-bottom: 12rpx;
}
.ltp__title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}
.ltp__meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
  line-height: 1.4;
}
.ltp__countdown {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-brand-color);
}
.ltp__points {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--td-text-color-placeholder);
}
.ltp__points.is-win {
  color: #10b981;
}
.ltp__tip {
  margin: 12rpx 0 28rpx;
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
  line-height: 1.45;
}
