<!--
  拆成两个 fixed 根：皮肤/灯带 z=90 仍被分类条(100)盖住；
  飘落单独 z=460，高于分类、低于导航(500)/搜索(510)，全屏飘落才能看见。
  virtualHost 多根注入页面，避免共用 z=90 层叠上下文把飘落困住。
-->
<view
  class="fest-portal fest-portal--under"
  style="position:fixed;left:0;top:0;width:0;height:0;overflow:visible;pointer-events:none;z-index:90;"
>
  <!-- ① 顶栏背景图 -->
  <view
    wx:if="{{visible && showSkin && assets.banner}}"
    class="fest-skin fest-skin--{{festivalId}}"
    style="position:fixed;left:0;right:0;top:0;z-index:90;pointer-events:none;overflow:hidden;height:{{skinHeightPx}}px;"
    aria-hidden="true"
  >
    <image class="fest-skin__img" src="{{assets.banner}}" mode="aspectFill" />
    <view class="fest-skin__fade" />
  </view>

  <!-- ② 灯带 + 微光（高度仅导航区，与分类条不重叠） -->
  <view
    wx:if="{{visible && showChrome}}"
    class="fest-chrome fest-chrome--{{festivalId}} {{paused ? 'fest--paused' : ''}}"
    style="position:fixed;left:0;right:0;top:0;z-index:480;pointer-events:none;overflow:hidden;height:{{chromeHeightPx}}px;"
    aria-hidden="true"
  >
    <view wx:if="{{sparkles.length}}" class="fest-sparkles">
      <view
        wx:for="{{sparkles}}"
        wx:key="id"
        class="fest-sparkles__dot fest-sparkles__dot--g{{item.group}}"
        style="{{item.style}}"
      />
    </view>

    <view wx:if="{{showLights && (assets.header || bulbs.length)}}" class="fest-garland">
      <image
        wx:if="{{assets.header}}"
        class="fest-garland__img"
        src="{{assets.header}}"
        mode="widthFix"
      />
      <view wx:if="{{showLights}}" class="fest-garland__glow">
        <view
          wx:for="{{bulbs}}"
          wx:key="id"
          class="fest-garland__bulb fest-garland__bulb--{{item.color}} fest-garland__bulb--g{{item.group}}"
          style="{{item.style}}"
        />
      </view>
    </view>
  </view>
</view>

<!-- ③ 飘落：独立层叠，全屏时可越过分类条 -->
<view
  wx:if="{{visible && showAmbient}}"
  class="fest-portal fest-portal--ambient"
  style="position:fixed;left:0;top:0;width:0;height:0;overflow:visible;pointer-events:none;z-index:460;"
>
  <view
    class="fest-ambient fest-ambient--{{fallScope}} fest-ambient--{{festivalId}} {{paused ? 'fest--paused' : ''}}"
    style="position:fixed;z-index:460;pointer-events:none;overflow:hidden;{{ambientStyle}}"
  >
    <view wx:if="{{showMotion}}" class="fest-ambient__motion" aria-hidden="true">
      <view
        wx:for="{{flakes}}"
        wx:key="id"
        class="fest-ambient__flake"
        style="{{item.wrapStyle}}"
      >
        <image class="fest-ambient__img" src="{{item.src}}" mode="aspectFit" />
      </view>
    </view>
  </view>
</view>
