<view
  class="pack-card {{selectMode && selected ? 'pack-card--selected' : ''}} {{selectMode && selectDisabled ? 'pack-card--disabled' : ''}}"
  style="width: {{cardWidth}}px;"
  hover-class="{{selectDisabled ? '' : 'pack-card--press'}}"
  hover-start-time="20"
  hover-stay-time="80"
  bindtap="onTap"
  bindlongpress="onLongPress"
>
  <view class="pack-card__media" style="height: {{mediaHeight}}px;">
    <t-image
      wx:if="{{coverUrl}}"
      class="pack-card__image"
      t-class="pack-card__t-image"
      t-class-image="{{coverReady ? 'pack-card__img pack-card__img--ready' : 'pack-card__img'}}"
      t-class-load="pack-card__load"
      src="{{coverUrl}}"
      mode="aspectFill"
      shape="square"
      lazy
      loading="slot"
      width="100%"
      height="100%"
      bind:load="onCoverLoad"
      bind:error="onCoverError"
    >
      <view slot="loading" class="pack-card__skeleton" aria-hidden="true" />
    </t-image>
    <view
      wx:if="{{typeBadge}}"
      class="pack-card__type-badge {{typeBadgeCompact ? 'pack-card__type-badge--compact' : ''}}"
      style="{{typeBadge.customStyle}}"
      aria-hidden="true"
    >
      <image
        class="pack-card__type-badge-icon"
        src="{{typeBadge.iconSrc}}"
        mode="aspectFit"
      />
      <text wx:if="{{!typeBadgeCompact}}" class="pack-card__type-badge-text">{{typeBadge.text}}</text>
    </view>
    <view wx:if="{{selectMode}}" class="pack-card__check" aria-hidden="true">
      <t-icon
        name="{{selected ? 'check-circle-filled' : 'circle'}}"
        size="40rpx"
        color="{{selected ? brandColor : 'rgba(255,255,255,0.92)'}}"
      />
    </view>
  </view>

  <view class="pack-card__info">
    <text class="pack-card__title">{{title}}</text>
    <view
      class="pack-card__meta-row"
      wx:if="{{tags.length || metaLine}}"
    >
      <view class="pack-card__tag-group" wx:if="{{tags.length}}">
        <block wx:for="{{tags}}" wx:key="text">
          <t-tag
            size="small"
            variant="light"
            theme="{{item.theme}}"
            custom-style="{{item.customStyle}}"
          >
            {{item.text}}
          </t-tag>
        </block>
      </view>
      <text wx:if="{{metaLine}}" class="pack-card__meta-line">{{metaLine}}</text>
    </view>
    <view class="pack-card__admin" wx:if="{{showAdmin && !selectMode && adminActionsVisible}}" catchtap="noop">
      <t-button
        t-class="pack-card__admin-btn"
        size="extra-small"
        theme="primary"
        variant="text"
        icon="edit"
        content="编辑"
        bind:tap="onEdit"
      />
      <view class="pack-card__admin-split" aria-hidden="true" />
      <t-button
        t-class="pack-card__admin-btn pack-card__admin-btn--danger"
        size="extra-small"
        theme="danger"
        variant="text"
        icon="delete"
        content="删除"
        bind:tap="onDelete"
      />
    </view>
  </view>
  <view
    wx:if="{{selectMode}}"
    class="pack-card__bar {{selected ? 'pack-card__bar--on' : ''}}"
    aria-hidden="true"
  />
</view>
