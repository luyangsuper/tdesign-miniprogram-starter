.fun-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 24rpx;
  /* —— bounce —— */
  /* —— orbit —— */
  /* —— wave —— */
  /* —— jelly —— */
}
.fun-loading--small {
  gap: 12rpx;
  padding: 8rpx;
}
.fun-loading--small .fun-loading__emoji {
  font-size: 36rpx;
}
.fun-loading--small .fun-loading__orbit {
  width: 72rpx;
  height: 72rpx;
}
.fun-loading--small .fun-loading__orbit-emoji {
  font-size: 28rpx;
}
.fun-loading--small .fun-loading__jelly-emoji {
  font-size: 48rpx;
}
.fun-loading--small .fun-loading__dot {
  width: 12rpx;
  height: 12rpx;
}
.fun-loading--small .fun-loading__text {
  font-size: 22rpx;
}
.fun-loading__text {
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
  line-height: 1.4;
}
.fun-loading__bounce {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 72rpx;
}
.fun-loading__emoji {
  font-size: 48rpx;
  line-height: 1;
  display: block;
  animation: fun-bounce 0.7s ease-in-out infinite;
}
.fun-loading__orbit {
  position: relative;
  width: 96rpx;
  height: 96rpx;
}
.fun-loading__orbit-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx solid var(--td-brand-color-light);
  border-top-color: var(--td-brand-color);
  animation: fun-spin 0.85s linear infinite;
  box-sizing: border-box;
}
.fun-loading__orbit-emoji {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
  line-height: 1;
  animation: fun-pulse 1.1s ease-in-out infinite;
}
.fun-loading__wave {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 48rpx;
}
.fun-loading__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--td-brand-color);
  animation: fun-wave 0.65s ease-in-out infinite;
}
.fun-loading__jelly {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fun-loading__jelly-emoji {
  font-size: 64rpx;
  line-height: 1;
  display: block;
  animation: fun-jelly 0.9s ease-in-out infinite;
  transform-origin: center bottom;
}
@keyframes fun-bounce {
  0%,
  80%,
  100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-22rpx);
  }
}
@keyframes fun-spin {
  to {
    transform: rotate(360deg);
  }
}
@keyframes fun-pulse {
  0%,
  100% {
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.12);
  }
}
@keyframes fun-wave {
  0%,
  80%,
  100% {
    transform: translateY(0) scale(1);
    opacity: 0.45;
  }
  40% {
    transform: translateY(-16rpx) scale(1.15);
    opacity: 1;
  }
}
@keyframes fun-jelly {
  0%,
  100% {
    transform: scale(1, 1);
  }
  30% {
    transform: scale(1.15, 0.85);
  }
  50% {
    transform: scale(0.9, 1.12);
  }
  70% {
    transform: scale(1.08, 0.92);
  }
}
