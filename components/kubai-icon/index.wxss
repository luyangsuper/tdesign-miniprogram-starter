.kubai-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  transform-origin: 50% 55%;
  will-change: transform;
}

.kubai-icon-wrap.is-play {
  /* 对齐 Kubai 官网 460ms + cubic-bezier(.22, 1, .36, 1)，用点击代替 hover */
  animation: kubai-tap 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.kubai-icon-wrap.is-static {
  animation: none !important;
}

.kubai-icon {
  width: 100%;
  height: 100%;
  display: block;
  flex-shrink: 0;
  vertical-align: middle;
  box-sizing: border-box;
  pointer-events: none;
}

@keyframes kubai-tap {
  0% {
    transform: scale(1) rotate(0deg);
  }
  28% {
    transform: scale(0.86) rotate(-6deg);
  }
  62% {
    transform: scale(1.1) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}
