<!-- 底栏始终实心；有节日底图时铺在实心底上，透明区露出栏体色而非页面内容 -->
<view
  wx:if="{{!hidden}}"
  class="page custom-tab-bar custom-tab-bar--{{value || 'home'}} {{festivalId ? 'custom-tab-bar--fest custom-tab-bar--' + festivalId : ''}}"
>
  <view
    wx:if="{{bankSrc}}"
    class="custom-tab-bar__bg-wrap"
    style="height: {{bankMaxPx}}px;"
    aria-hidden="true"
  >
    <image class="custom-tab-bar__bg" src="{{bankSrc}}" mode="scaleToFill" />
  </view>
  <view class="custom-tab-bar__inner">
    <t-tab-bar
      value="{{value}}"
      bordered="{{false}}"
      split="{{false}}"
      fixed="{{false}}"
      safe-area-inset-bottom="{{true}}"
      bindchange="onChange"
    >
      <t-tab-bar-item t-class="tab-bar-item" value="home">
        <image
          slot="icon"
          class="custom-tab-bar__icon"
          src="{{value === 'home' ? '/static/tab/home-active.png' : '/static/tab/home.png'}}"
          mode="aspectFit"
        />
        首页
      </t-tab-bar-item>
      <t-tab-bar-item t-class="tab-bar-item" value="my">
        <image
          slot="icon"
          class="custom-tab-bar__icon"
          src="{{value === 'my' ? '/static/tab/my-active.png' : '/static/tab/my.png'}}"
          mode="aspectFit"
        />
        我的
      </t-tab-bar-item>
    </t-tab-bar>
  </view>
</view>
