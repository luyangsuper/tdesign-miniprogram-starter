    "festival:solar": "node scripts/gen-festival-solar-table.js",
    "build:npm": "node scripts/build-miniprogram-npm.js",
    "library:import": "node scripts/library-import/import.mjs",
    "library:upload": "node scripts/library-import/upload-remote.mjs",
    "library:upload:packs": "node scripts/library-import/upload-open-packs.mjs",
    "library:upload:particlefx": "node scripts/library-import/upload-particlefx.mjs",
    "avatar-frames:upload": "node scripts/avatar-frames/import-upload.mjs",
    "avatar-frames:classify": "node scripts/avatar-frames/classify-access.mjs",
    "gifski:wx": "node scripts/patch-gifski-wx.mjs"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "cloud",
    "emoji"
  ],
