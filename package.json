{
  "name": "emoji-share",
  "version": "3.1.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "npx eslint ./ --no-eslintrc -c ./.eslintrc.js",
    "lint:fix": "npm run lint:fix-eslint && npm run lint:fix-prettier",
    "lint:fix-eslint": "eslint --ext .js,.ts ./ --max-warnings 0 --ignore-path .gitignore --ignore-path .eslintignore --fix",
    "lint:fix-prettier": "prettier ./ --ignore-path .gitignore --ignore-path .eslintignore --ignore-path .prettierignore --write './**/*.{js,ts}' --ignore-unknown",
    "icons:gen": "node scripts/generate-iconpark-assets.js",
    "festival:gen": "node scripts/generate-festival-assets.js",
    "festival:fit": "node scripts/fit-festival-image.js",
    "festival:solar": "node scripts/gen-festival-solar-table.js",
    "build:npm": "node scripts/build-miniprogram-npm.js"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "cloud",
    "emoji"
  ],
  "author": "leejim",
  "license": "MIT",
  "description": "趣图铺子 · 微信云开发合集分享（表情/壁纸/头像/视频）：封面/预览/原文件，积分保存到相册",
  "dependencies": {
    "dayjs": "^1.11.13",
    "tdesign-miniprogram": "^1.11.2"
  },
  "devDependencies": {
    "lunar-javascript": "^1.7.7",
    "@icon-park/svg": "^1.4.2",
    "eslint": "^8.49.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "less": "^4.9.1",
    "lint-staged": "^14.0.1",
    "prettier": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "lint-staged": {
    "{src,example,script}/**/*.{js,ts,wxml,html,json,less}": [
      "prettier --write"
    ],
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  }
}
