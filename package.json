  "license": "MIT",
  "description": "???? ? ?????????",
  "dependencies": {
    "dayjs": "^1.11.13",
    "gifski-wasm": "^2.2.0",
    "tdesign-miniprogram": "^1.11.2"
  },
  "devDependencies": {
    "@cloudbase/node-sdk": "^4.2.1",
    "eslint": "^8.49.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "less": "^4.9.1",
    "lint-staged": "^14.0.1",
    "lunar-javascript": "^1.7.7",
    "prettier": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "lint-staged": {
    "{src,example,script}/**/*.{js,ts,wxml,html,json,less}": [
      "prettier --write"
    ],
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  }
