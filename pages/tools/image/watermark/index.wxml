<view class="imgtool-page {{festivalClass}}" style="{{themeStyle}};{{festivalStyle}};{{navBarStyle}}">
  <festival-decor
    id="festivalDecor"
    mode="navbar"
    active="{{festivalActive}}"
    header-height="{{festHeaderPx}}"
    nav-height="{{navHeight}}"
  />
  <t-navbar
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{500}}"
    left-arrow
    custom-style="{{navBarStyle}}"
    bind:go-back="onBack"
  >
    <view slot="title" class="imgtool__nav-title">加水印</view>
  </t-navbar>

  <view class="imgtool">
    <view class="imgtool__hero">
      <text class="imgtool__kicker">图片工具箱</text>
      <text class="imgtool__hero-title">加水印</text>
      <text class="imgtool__hero-desc">{{heroDesc}}</text>
    </view>

    <view
      wx:if="{{showNativeAd && nativeAdUnitId}}"
      class="imgtool__native-ad"
    >
      <ad-custom
        unit-id="{{nativeAdUnitId}}"
        binderror="onNativeAdError"
      />
    </view>


    <view class="imgtool__card">
      <view class="imgtool__card-title">原图</view>
      <view
        class="imgtool__preview {{!srcPath ? 'imgtool__preview--pick' : ''}}"
        bindtap="onPick"
        hover-class="imghub__card--hover"
      >
        <block wx:if="{{srcPath}}">
          <image class="imgtool__preview-img" src="{{srcPath}}" mode="aspectFit" />
        </block>
        <view wx:elif="{{!checking}}" class="imgtool__preview-empty">
          <kubai-icon name="image" size="56rpx" color="{{themeBrand}}" />
          <text class="imgtool__preview-empty-title">点此选图</text>
          <text class="imgtool__preview-empty-text">需通过安全检测后才能处理</text>
        </view>
        <view wx:if="{{checking}}" class="imgtool__preview-loading">
          <t-loading theme="circular" size="40rpx" text="{{checkText}}" />
        </view>
      </view>
      <view wx:if="{{srcMeta}}" class="imgtool__meta">{{srcMeta}}</view>
    </view>

    <view class="imgtool__card">
      <view class="imgtool__card-title">参数</view>
      <view class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">水印类型</text>
        </view>
        <view class="imgtool__chip-grid imgtool__chip-grid--2">
          <view
            class="imgtool__chip {{wmType === 'text' ? 'is-on' : ''}}"
            data-v="text"
            bindtap="onWmType"
          >文字水印</view>
          <view
            class="imgtool__chip {{wmType === 'image' ? 'is-on' : ''}}"
            data-v="image"
            bindtap="onWmType"
          >图片水印</view>
        </view>
      </view>
      <view wx:if="{{wmType === 'text'}}" class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">水印文字</text>
        </view>
        <view class="imgtool__field">
          <t-input
            borderless
            value="{{wmText}}"
            maxlength="{{24}}"
            placeholder="输入水印文字"
            bind:change="onWmText"
          />
        </view>
      </view>
      <view wx:else class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">水印图</text>
          <text class="imgtool__value">{{wmPath ? '已选择' : '未选择'}}</text>
        </view>
        <t-button
          theme="light"
          size="medium"
          shape="round"
          block
          content="{{wmPath ? '更换水印图' : '选择水印图（推荐透明 PNG）'}}"
          disabled="{{checking || busy}}"
          bind:tap="onPickWm"
        />
        <image
          wx:if="{{wmPath}}"
          src="{{wmPath}}"
          mode="aspectFit"
          style="margin-top: 12rpx; width: 160rpx; height: 160rpx; border-radius: 12rpx; background: rgba(15,23,42,0.04);"
        />
      </view>
      <view class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">位置</text>
        </view>
        <view class="imgtool__chip-grid imgtool__chip-grid--3">
          <view
            wx:for="{{posList}}"
            wx:key="id"
            class="imgtool__chip {{wmPos === item.id ? 'is-on' : ''}}"
            data-v="{{item.id}}"
            bindtap="onWmPos"
          >{{item.label}}</view>
        </view>
      </view>
      <view wx:if="{{wmType === 'text'}}" class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">文字颜色</text>
        </view>
        <view class="imgtool__chip-grid imgtool__chip-grid--3">
          <view
            wx:for="{{colorList}}"
            wx:key="v"
            class="imgtool__chip {{wmColor === item.v ? 'is-on' : ''}}"
            data-v="{{item.v}}"
            bindtap="onWmColor"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">透明度</text>
          <text class="imgtool__value">{{opacityLabel}}</text>
        </view>
        <t-slider
          class="imgtool__slider"
          value="{{opacityPct}}"
          min="{{10}}"
          max="{{90}}"
          step="{{1}}"
          label
          bind:change="onOpacity"
        />
      </view>
      <view wx:if="{{wmType === 'text'}}" class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">字号</text>
          <text class="imgtool__value">{{fontSize}}</text>
        </view>
        <t-slider
          class="imgtool__slider"
          value="{{fontSize}}"
          min="{{18}}"
          max="{{120}}"
          step="{{2}}"
          label
          bind:change="onFontSize"
        />
      </view>
      <view wx:else class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">水印大小</text>
          <text class="imgtool__value">{{sizePct}}%</text>
        </view>
        <t-slider
          class="imgtool__slider"
          value="{{sizePct}}"
          min="{{4}}"
          max="{{40}}"
          step="{{1}}"
          label
          bind:change="onSizePct"
        />
      </view>
    </view>

    <view class="imgtool__card">
      <view class="imgtool__card-title">结果</view>
      <view
        wx:if="{{paramsDirty && outPath}}"
        class="imgtool__dirty-tip"
        bindtap="onProcess"
      >
        <text class="imgtool__dirty-tip-t">参数已改，点这里重新处理</text>
        <text class="imgtool__dirty-tip-go">去处理</text>
      </view>
      <view class="imgtool__preview">
        <block wx:if="{{outPath}}">
          <image class="imgtool__preview-img" src="{{outPath}}" mode="aspectFit" />
        </block>
        <view wx:else class="imgtool__preview-empty">
          <text class="imgtool__preview-empty-text">处理好后在这里预览</text>
        </view>
      </view>
      <view wx:if="{{outMeta}}" class="imgtool__meta">{{outMeta}}</view>
      <view class="imgtool__actions">
        <t-button
          theme="light"
          size="large"
          shape="round"
          block
          content="{{busy ? '处理中…' : (paramsDirty ? '重新处理' : '开始处理')}}"
          disabled="{{!srcPath || busy || checking}}"
          bind:tap="onProcess"
        />
        <t-button
          theme="primary"
          size="large"
          shape="round"
          block
          content="{{gating ? '解锁中…' : '保存到相册'}}"
          disabled="{{!outPath || busy || gating}}"
          bind:tap="onSave"
        />
      </view>
      <text class="imgtool__hint">处理免费；保存需积分解锁或看一次广告</text>
    </view>
  </view>
</view>
