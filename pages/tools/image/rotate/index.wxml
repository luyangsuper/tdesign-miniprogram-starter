<view class="imgtool-page {{festivalClass}}" style="{{themeStyle}};{{festivalStyle}};{{navBarStyle}}">
  <festival-decor
    id="festivalDecor"
    mode="navbar"
    active="{{festivalActive}}"
    header-height="{{festHeaderPx}}"
    nav-height="{{navHeight}}"
  />
  <t-navbar
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{500}}"
    left-arrow
    custom-style="{{navBarStyle}}"
    bind:go-back="onBack"
  >
    <view slot="title" class="imgtool__nav-title">旋转翻转</view>
  </t-navbar>

  <view class="imgtool">
    <view class="imgtool__hero">
      <text class="imgtool__kicker">图片工具箱</text>
      <text class="imgtool__hero-title">旋转翻转</text>
      <text class="imgtool__hero-desc">{{heroDesc}}</text>
    </view>

    <view
      wx:if="{{showNativeAd && nativeAdUnitId}}"
      class="imgtool__native-ad"
    >
      <ad-custom
        unit-id="{{nativeAdUnitId}}"
        binderror="onNativeAdError"
      />
    </view>

    <view class="imgtool__card">
      <view class="imgtool__card-title">原图</view>
      <view
        class="imgtool__preview {{!srcPath ? 'imgtool__preview--pick' : ''}}"
        bindtap="onPick"
        hover-class="imghub__card--hover"
      >
        <block wx:if="{{srcPath}}">
          <image class="imgtool__preview-img" src="{{srcPath}}" mode="aspectFit" />
        </block>
        <view wx:elif="{{!checking}}" class="imgtool__preview-empty">
          <kubai-icon name="image" size="56rpx" color="{{themeBrand}}" />
          <text class="imgtool__preview-empty-title">点此选图</text>
          <text class="imgtool__preview-empty-text">需通过安全检测后才能处理</text>
        </view>
        <view wx:if="{{checking}}" class="imgtool__preview-loading">
          <t-loading theme="circular" size="40rpx" text="{{checkText}}" />
        </view>
      </view>
      <view wx:if="{{srcMeta}}" class="imgtool__meta">{{srcMeta}}</view>
    </view>

    <view class="imgtool__card">
      <view class="imgtool__card-title">参数</view>
      <view class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">旋转</text>
          <text class="imgtool__value">{{rotate}}°</text>
        </view>
        <view class="imgtool__chip-grid imgtool__chip-grid--2">
          <view
            wx:for="{{rotatePresets}}"
            wx:key="v"
            class="imgtool__chip {{rotate === item.v ? 'is-on' : ''}}"
            data-v="{{item.v}}"
            bindtap="onRotate"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">翻转</text>
        </view>
        <view class="imgtool__chip-grid imgtool__chip-grid--2">
          <view
            class="imgtool__chip {{flipH ? 'is-on' : ''}}"
            bindtap="onFlipH"
          >水平翻转</view>
          <view
            class="imgtool__chip {{flipV ? 'is-on' : ''}}"
            bindtap="onFlipV"
          >垂直翻转</view>
        </view>
      </view>
    </view>

    <view class="imgtool__card">
      <view class="imgtool__card-title">结果</view>
      <view
        wx:if="{{paramsDirty && outPath}}"
        class="imgtool__dirty-tip"
        bindtap="onProcess"
      >
        <text class="imgtool__dirty-tip-t">参数已改，点这里重新处理</text>
        <text class="imgtool__dirty-tip-go">去处理</text>
      </view>
      <view class="imgtool__preview">
        <block wx:if="{{outPath}}">
          <image class="imgtool__preview-img" src="{{outPath}}" mode="aspectFit" />
        </block>
        <view wx:else class="imgtool__preview-empty">
          <text class="imgtool__preview-empty-text">处理好后在这里预览</text>
        </view>
      </view>
      <view wx:if="{{outMeta}}" class="imgtool__meta">{{outMeta}}</view>
      <view class="imgtool__actions">
        <t-button
          theme="light"
          size="large"
          shape="round"
          block
          content="{{busy ? '处理中…' : (paramsDirty ? '重新处理' : '开始处理')}}"
          disabled="{{!srcPath || busy || checking}}"
          bind:tap="onProcess"
        />
        <t-button
          theme="primary"
          size="large"
          shape="round"
          block
          content="{{gating ? '解锁中…' : '保存到相册'}}"
          disabled="{{!outPath || busy || gating}}"
          bind:tap="onSave"
        />
      </view>
      <text class="imgtool__hint">处理免费；保存需积分解锁或看一次广告</text>
    </view>
  </view>
</view>
