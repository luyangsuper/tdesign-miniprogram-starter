<view class="imgtool-page {{festivalClass}}" style="{{themeStyle}};{{festivalStyle}};{{navBarStyle}}">
  <festival-decor
    id="festivalDecor"
    mode="navbar"
    active="{{festivalActive}}"
    header-height="{{festHeaderPx}}"
    nav-height="{{navHeight}}"
  />
  <t-navbar
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{500}}"
    left-arrow
    custom-style="{{navBarStyle}}"
    bind:go-back="onBack"
  >
    <view slot="title" class="imgtool__nav-title">拼接长图</view>
  </t-navbar>

  <view class="imgtool">
    <view class="imgtool__hero">
      <text class="imgtool__kicker">图片工具箱</text>
      <text class="imgtool__hero-title">拼接长图</text>
      <text class="imgtool__hero-desc">选 2～9 张图，横拼或竖拼成一张</text>
    </view>

    <view class="imgtool__card">
      <view class="imgtool__card-title">图片（{{srcCount}}/9）</view>
      <view class="imgtool__thumbs">
        <view class="imgtool__thumb" wx:for="{{srcList}}" wx:key="path">
          <image class="imgtool__thumb-img" src="{{item.path}}" mode="aspectFill" />
        </view>
        <view
          wx:if="{{srcCount < 9}}"
          class="imgtool__thumb imgtool__thumb--add"
          bindtap="onPick"
          hover-class="imghub__card--hover"
        >
          <kubai-icon name="plus" size="40rpx" color="{{themeBrand}}" />
        </view>
      </view>
      <view wx:if="{{checking}}" class="imgtool__checking">
        <t-loading theme="circular" size="40rpx" text="{{checkText}}" />
      </view>
      <view class="imgtool__actions" style="margin-top: 16rpx;">
        <t-button
          theme="light"
          size="medium"
          shape="round"
          block
          content="重新选图"
          disabled="{{checking || busy}}"
          bind:tap="onRepick"
        />
      </view>
    </view>

    <view class="imgtool__card">
      <view class="imgtool__card-title">参数</view>
      <view class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">方向</text>
          <text class="imgtool__value">{{direction === 'horizontal' ? '横向' : '纵向'}}</text>
        </view>
        <view class="imgtool__chip-grid imgtool__chip-grid--2">
          <view
            class="imgtool__chip {{direction === 'vertical' ? 'is-on' : ''}}"
            data-v="vertical"
            bindtap="onDirection"
          >纵向</view>
          <view
            class="imgtool__chip {{direction === 'horizontal' ? 'is-on' : ''}}"
            data-v="horizontal"
            bindtap="onDirection"
          >横向</view>
        </view>
      </view>
      <view class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">间距</text>
          <text class="imgtool__value">{{gap}} px</text>
        </view>
        <t-slider
          class="imgtool__slider"
          value="{{gap}}"
          min="{{0}}"
          max="{{48}}"
          step="{{2}}"
          label
          bind:change="onGap"
        />
      </view>
      <view class="imgtool__param">
        <view class="imgtool__param-head">
          <text class="imgtool__label">背景</text>
        </view>
        <view class="imgtool__chip-grid imgtool__chip-grid--3">
          <view
            wx:for="{{bgList}}"
            wx:key="v"
            class="imgtool__chip {{bgColor === item.v ? 'is-on' : ''}}"
            data-v="{{item.v}}"
            bindtap="onBg"
          >{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="imgtool__card">
      <view class="imgtool__card-title">结果</view>
      <view class="imgtool__preview">
        <block wx:if="{{outPath}}">
          <image class="imgtool__preview-img" src="{{outPath}}" mode="aspectFit" />
        </block>
        <view wx:else class="imgtool__preview-empty">
          <text class="imgtool__preview-empty-text">拼好后在这里预览</text>
        </view>
      </view>
      <view wx:if="{{outMeta}}" class="imgtool__meta">{{outMeta}}</view>
      <view class="imgtool__actions">
        <t-button
          theme="light"
          size="large"
          shape="round"
          block
          content="{{busy ? '拼接中…' : '开始拼接'}}"
          disabled="{{srcCount < 2 || busy || checking}}"
          bind:tap="onProcess"
        />
        <t-button
          theme="primary"
          size="large"
          shape="round"
          block
          content="{{gating ? '解锁中…' : '保存到相册'}}"
          disabled="{{!outPath || busy || gating}}"
          bind:tap="onSave"
        />
      </view>
      <text class="imgtool__hint">处理免费；保存需积分解锁或看一次广告</text>
    </view>
  </view>
</view>
