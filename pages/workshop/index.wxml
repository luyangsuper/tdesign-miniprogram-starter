<view class="workshop-page {{festivalClass}}" style="{{themeStyle}};{{festivalStyle}};{{navBarStyle}}">
  <festival-decor
    id="festivalDecor"
    mode="my"
    active="{{festivalActive}}"
    header-height="{{festHeaderPx}}"
    nav-height="{{navHeight}}"
  />
  <t-navbar
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{500}}"
    custom-style="{{navBarStyle}}"
  >
    <view slot="title" class="workshop__nav-title">趣味工坊</view>
  </t-navbar>

  <scroll-view scroll-y class="workshop-scroll" enhanced show-scrollbar="{{false}}">
    <view class="workshop">
      <view class="workshop__banner">
        <text class="workshop__banner-kicker">WORKSHOP</text>
        <text class="workshop__banner-title">动手玩一玩</text>
        <text class="workshop__banner-desc">拼豆 · 拼图 · 答案之书</text>
      </view>

      <view class="workshop__list">
        <view
          wx:for="{{tools}}"
          wx:key="id"
          class="workshop__card"
          data-url="{{item.url}}"
          bindtap="goTool"
          hover-class="workshop__card--hover"
          hover-stay-time="80"
        >
          <view class="workshop__preview workshop__preview--{{item.id}}">
            <block wx:if="{{item.id === 'bead'}}">
              <view class="pv-grid">
                <view
                  class="pv-grid__cell"
                  wx:for="{{beadCells}}"
                  wx:for-item="c"
                  wx:for-index="ci"
                  wx:key="ci"
                  style="background: {{c}};"
                />
              </view>
            </block>
            <block wx:elif="{{item.id === 'puzzle'}}">
              <view class="pv-grid pv-grid--puzzle">
                <view
                  class="pv-grid__cell {{pi === 8 ? 'pv-grid__cell--empty' : ''}}"
                  wx:for="{{puzzleCells}}"
                  wx:for-item="c"
                  wx:for-index="pi"
                  wx:key="pi"
                  style="background: {{c}};"
                />
              </view>
            </block>
            <block wx:else>
              <view class="pv-book">
                <view class="pv-book__page pv-book__page--left">
                  <text class="pv-book__line" />
                  <text class="pv-book__line pv-book__line--short" />
                  <text class="pv-book__line" />
                </view>
                <view class="pv-book__spine" />
                <view class="pv-book__page pv-book__page--right">
                  <text class="pv-book__mark">✦</text>
                </view>
              </view>
            </block>
          </view>

          <view class="workshop__meta">
            <view class="workshop__meta-icon" style="background: {{item.bg}};">
              <kubai-icon name="{{item.icon}}" size="36rpx" color="{{item.color}}" />
            </view>
            <view class="workshop__meta-body">
              <view class="workshop__meta-head">
                <text class="workshop__meta-title">{{item.title}}</text>
                <t-tag
                  wx:if="{{item.tag}}"
                  size="small"
                  variant="light"
                  theme="{{item.tagTheme || 'success'}}"
                >{{item.tag}}</t-tag>
              </view>
              <text class="workshop__meta-desc">{{item.desc}}</text>
            </view>
            <kubai-icon name="chevron-right" size="32rpx" color="rgba(15,23,42,0.28)" />
          </view>
        </view>
      </view>

      <view
        wx:if="{{showNativeAd && nativeAdUnitId}}"
        class="workshop__native-ad"
      >
        <ad-custom
          unit-id="{{nativeAdUnitId}}"
          binderror="onNativeAdError"
        />
      </view>
    </view>
  </scroll-view>
</view>
