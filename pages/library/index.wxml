<page-meta page-style="{{themeStyle}}" />
<view class="lib-hub" style="{{themeStyle}};{{navBarStyle}}">
  <t-navbar
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{500}}"
    left-arrow
    bind:go-back="onBack"
    custom-style="{{navBarStyle}}"
  >
    <view slot="title" class="lib-hub__nav-title">素材库</view>
  </t-navbar>

  <scroll-view scroll-y class="lib-hub__scroll" enhanced show-scrollbar="{{false}}">
    <view class="lib-hub__body">
      <view class="lib-hub__intro">
        <text class="lib-hub__kicker">LIBRARY</text>
        <text class="lib-hub__title">发现更多有趣素材</text>
        <text class="lib-hub__desc">按风格挑选，点开即可浏览下载</text>
      </view>

      <view
        wx:if="{{showNativeAd && nativeAdUnitId}}"
        class="lib-hub__native-ad"
      >
        <ad-custom
          unit-id="{{nativeAdUnitId}}"
          binderror="onNativeAdError"
        />
      </view>

      <view wx:if="{{loading}}" class="lib-hub__state">
        <fun-loading />
      </view>

      <view wx:elif="{{!sources.length}}" class="lib-hub__state">
        <fun-empty description="{{emptyTip}}" />
      </view>

      <view wx:else class="lib-hub__list">
        <view
          wx:for="{{sources}}"
          wx:key="id"
          class="lib-hub__card"
          data-id="{{item.id}}"
          bindtap="onOpenSource"
          hover-class="lib-hub__card--press"
          hover-start-time="20"
          hover-stay-time="80"
        >
          <view class="lib-hub__card-head">
            <view class="lib-hub__card-title-wrap">
              <text class="lib-hub__card-title">{{item.title}}</text>
              <t-tag
                wx:if="{{item.isFree}}"
                size="small"
                variant="light"
                theme="success"
              >免费</t-tag>
              <t-tag
                wx:if="{{item.badge}}"
                size="small"
                variant="light"
              >{{item.badge}}</t-tag>
            </view>
            <text class="lib-hub__card-more">进入</text>
          </view>

          <view class="lib-hub__card-grid">
            <block wx:if="{{item.previewSlots.length}}">
              <view
                wx:for="{{item.previewSlots}}"
                wx:for-item="thumb"
                wx:for-index="ti"
                wx:key="ti"
                class="lib-hub__card-cell"
              >
                <smart-image
                  src="{{thumb.url}}"
                  file-id="{{thumb.fileId}}"
                  mode="aspectFill"
                  shape="round"
                  lazy
                  webp
                  radius="14rpx"
                  transparent
                />
                <view
                  wx:if="{{item.moreCount > 0 && ti === item.previewSlots.length - 1}}"
                  class="lib-hub__card-moremask"
                >+{{item.moreCount}}</view>
              </view>
            </block>
            <block wx:else>
              <view
                wx:for="{{item.thumbs}}"
                wx:for-item="emo"
                wx:for-index="ei"
                wx:key="ei"
                class="lib-hub__card-cell lib-hub__card-cell--emoji"
              >
                <text class="lib-hub__card-emoji">{{emo}}</text>
                <view
                  wx:if="{{item.moreCount > 0 && ei === item.thumbs.length - 1}}"
                  class="lib-hub__card-moremask"
                >+{{item.moreCount}}</view>
              </view>
            </block>
          </view>

          <view class="lib-hub__card-foot">
            <text class="lib-hub__card-desc">{{item.desc}}</text>
            <text class="lib-hub__card-meta">{{item.countText}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
