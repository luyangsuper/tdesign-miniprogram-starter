<page-meta page-style="{{themeStyle}}" />
<view class="lib-hub" style="{{themeStyle}};{{navBarStyle}}">
  <t-navbar
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{500}}"
    left-arrow
    bind:go-back="onBack"
    custom-style="{{navBarStyle}}"
  >
    <view slot="title" class="lib-hub__nav-title">素材库</view>
  </t-navbar>

  <scroll-view scroll-y class="lib-hub__scroll" enhanced show-scrollbar="{{false}}">
    <view class="lib-hub__body">
      <view class="lib-hub__intro">
        <text class="lib-hub__kicker">LIBRARY</text>
        <text class="lib-hub__title">发现更多有趣素材</text>
        <text class="lib-hub__desc">按风格挑选，点开即可浏览下载</text>
      </view>

      <view wx:if="{{loading}}" class="lib-hub__state">
        <fun-loading />
      </view>

      <view wx:elif="{{!sources.length}}" class="lib-hub__state">
        <fun-empty description="{{emptyTip}}" />
      </view>

      <view wx:else class="lib-hub__list">
        <view
          wx:for="{{sources}}"
          wx:key="id"
          class="lib-hub__card"
          data-id="{{item.id}}"
          bindtap="onOpenSource"
          hover-class="lib-hub__card--press"
          hover-stay-time="80"
        >
          <view class="lib-hub__card-main">
            <view class="lib-hub__card-head">
              <text class="lib-hub__card-title">{{item.title}}</text>
              <t-tag wx:if="{{item.badge}}" size="small" variant="light" content="{{item.badge}}" />
            </view>
            <text class="lib-hub__card-desc">{{item.desc}}</text>
            <view class="lib-hub__card-meta">
              <text>{{item.countText}}</text>
              <text class="lib-hub__card-dot">·</text>
              <text>{{item.formatsText}}</text>
            </view>
            <view class="lib-hub__card-cta">
              <text>进入浏览</text>
              <text class="cta-arrow">→</text>
            </view>
          </view>
          <view class="lib-hub__card-previews">
            <block wx:if="{{item.previewUrls.length}}">
              <image
                wx:for="{{item.previewUrls}}"
                wx:for-item="thumb"
                wx:for-index="ti"
                wx:key="ti"
                class="lib-hub__thumb"
                src="{{thumb}}"
                mode="aspectFill"
                lazy-load
              />
            </block>
            <block wx:else>
              <view
                wx:for="{{item.thumbs}}"
                wx:for-item="emo"
                wx:for-index="ei"
                wx:key="ei"
                class="lib-hub__thumb lib-hub__thumb--emoji"
              >
                <text class="lib-hub__thumb-emoji">{{emo}}</text>
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
