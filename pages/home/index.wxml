<wxs src="./refresher.wxs" module="rf" />
<view
  class="home {{selectMode ? 'home--select' : ''}} {{festivalClass}}"
  style="{{themeStyle}};{{festivalStyle}}"
>
  <festival-decor
    id="festivalDecor"
    mode="home"
    active="{{festivalActive}}"
    header-height="{{festHeaderPx}}"
    nav-height="{{navHeight}}"
  />
  <t-navbar
    title="{{searchExpanded ? '' : '趣集'}}"
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{500}}"
    t-class="home__navbar"
  />
  <!-- 搜索抬到导航行：展开用 left+right 限位，右缘停在「多选」左侧 -->
  <view
    class="home__search {{searchExpanded ? 'home__search--open' : ''}}"
    style="{{searchBoxStyle}}"
  >
    <view
      class="home__search-fab"
      style="width: {{searchBarHeight}}px; height: {{searchBarHeight}}px;"
      hover-class="home__search-fab--press"
      bindtap="openSearch"
      aria-role="button"
      aria-label="搜索"
    >
      <t-icon name="search" size="{{searchIconSize}}" />
      <view wx:if="{{keyword && !searchExpanded}}" class="home__search-dot" aria-hidden="true" />
    </view>
    <view class="home__search-panel" style="height: {{searchBarHeight}}px;">
      <view
        class="home__search-collapse"
        style="height: {{searchBarHeight}}px;"
        hover-class="home__search-collapse--press"
        catchtap="closeSearch"
        aria-role="button"
        aria-label="收起搜索"
      >
        <t-icon name="chevron-left" size="{{searchIconSize}}" />
      </view>
      <t-search
        t-class="home__search-input"
        value="{{keyword}}"
        shape="round"
        placeholder="搜索标题 / 简介 / 分类"
        clearable
        focus="{{searchFocus}}"
        bind:change="onSearchChange"
        bind:submit="onSearchSubmit"
        bind:clear="onSearchClear"
        bind:blur="onSearchBlur"
      />
    </view>
  </view>
  <!-- 本版 t-navbar 无 right 插槽，贴胶囊左侧放多选/取消 -->
  <view
    class="home__nav-action"
    style="top: {{menuButton.top}}px; height: {{menuButton.height}}px; right: {{menuButton.gap}}px;"
    hover-class="home__nav-action--press"
    hover-stay-time="60"
    bindtap="onToggleSelectMode"
  >{{selectMode ? '取消' : '多选'}}</view>

  <view class="home__fixed" style="top: {{navHeight}}px;">
    <scroll-view
      class="home__toolbar"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      enable-flex
      scroll-with-animation
      scroll-left="{{catScrollLeft}}"
    >
      <view class="home__toolbar-inner">
        <view
          wx:for="{{filters}}"
          wx:key="id"
          id="cat-{{item.id}}"
          class="home__cat-wrap"
        >
          <t-check-tag
            t-class="home__cat"
            size="medium"
            shape="round"
            variant="light"
            content=""
            checked="{{item.id === categoryId}}"
            custom-style="{{item.checkStyle}}"
            data-id="{{item.id}}"
            bind:change="onCategoryTap"
          >
            <view class="home__cat-inner">
              <text class="home__cat-name">{{item.name}}</text>
              <text
                class="home__cat-count {{item.id === categoryId ? 'home__cat-count--show' : ''}}"
              >{{item.id === categoryId ? listTotal : item.count}}</text>
            </view>
          </t-check-tag>
        </view>
      </view>
    </scroll-view>
  </view>

  <view
    class="home__body"
    style="padding-top: {{fixedOffset}}px;"
    bindtouchstart="onBodyTouchStart"
    bindtouchmove="onBodyTouchMove"
    bindtouchend="onBodyTouchEnd"
    bindtouchcancel="onBodyTouchEnd"
  >
    <view class="home__swipe-stage">
      <!-- 露白提示：hidden 代替 wx:if，避免跟手时反复挂载 -->
      <view
        class="home__swipe-hint home__swipe-hint--left"
        hidden="{{!swipeHintLeft.show}}"
        style="width: {{swipeHintLeft.revealWidth}}px; top: {{navHeight + fixedOffset}}px; opacity: {{swipeHintLeft.opacity}};"
      >
        <image class="home__swipe-hint-icon" src="{{swipeHintLeft.icon}}" mode="aspectFit" />
        <text class="home__swipe-hint-title">{{swipeHintLeft.title}}</text>
        <text class="home__swipe-hint-name">{{swipeHintLeft.name}}</text>
      </view>
      <view
        class="home__swipe-hint home__swipe-hint--right"
        hidden="{{!swipeHintRight.show}}"
        style="width: {{swipeHintRight.revealWidth}}px; top: {{navHeight + fixedOffset}}px; opacity: {{swipeHintRight.opacity}};"
      >
        <image class="home__swipe-hint-icon" src="{{swipeHintRight.icon}}" mode="aspectFit" />
        <text class="home__swipe-hint-title">{{swipeHintRight.title}}</text>
        <text class="home__swipe-hint-name">{{swipeHintRight.name}}</text>
      </view>

      <view
        class="home__pane {{swipeDragging ? 'home__pane--dragging' : ''}} {{swipeX ? 'home__pane--away' : ''}}"
        style="transform: translate3d({{swipeX}}px, 0, 0); padding-left: {{listGap}}px; padding-right: {{listGap}}px;"
      >
        <view class="home__pane-inner home__pane-inner--{{pageAnim}}">
          <!--
            用原生 scroll-view：TDesign pull-down-refresh 无法动态关 scroll-y，
            左右滑切分类时必须禁止纵向滚动，否则和跟手 transform 抢主线程会卡顿。
          -->
          <scroll-view
            class="home__scroller"
            style="height: {{scrollerHeight}}px;"
            scroll-y="{{!swipeScrollLock}}"
            enhanced
            show-scrollbar="{{false}}"
            bounces="{{false}}"
            scroll-top="{{scrollerTop}}"
            scroll-into-view="{{scrollerIntoView}}"
            scroll-with-animation
            refresher-enabled="{{!swipeScrollLock}}"
            refresher-threshold="{{80}}"
            refresher-default-style="none"
            refresher-triggered="{{enable}}"
            refresher-ballistic-refresh-enabled="{{false}}"
            lower-threshold="{{160}}"
            bindrefresherpulling="{{rf.onPulling}}"
            bindrefresherrefresh="onRefresh"
            bindrefresherrestore="{{rf.onRestore}}"
            bindrefresherabort="{{rf.onAbort}}"
            bindscrolltolower="onScrollToLower"
            bindscroll="onListScroll"
          >
            <!--
              下拉过程文案用 WXS 切，勿在 pulling 里 setData，
              否则真机常见：停手后 refresher 仍继续往下窜。
            -->
            <view slot="refresher" class="home__refresher">
              <fun-loading
                size="small"
                variant="wave"
                funTips="{{false}}"
                text="{{enable ? '正在刷新' : ''}}"
              />
              <view wx:if="{{!enable}}" class="js-rf-pull home__refresher-text">下拉刷新</view>
              <view
                wx:if="{{!enable}}"
                class="js-rf-release home__refresher-text"
                style="display: none;"
              >松手刷新</view>
            </view>
            <view id="homeScrollerTop" class="home__scroller-anchor" />
            <block wx:if="{{!loading && list.length}}">
              <view class="home__list" style="gap: {{listGap}}px;">
                <view
                  class="home__col"
                  wx:for="{{columns}}"
                  wx:for-item="col"
                  wx:for-index="colIndex"
                  wx:key="colIndex"
                  style="width: {{cardWidth}}px; gap: {{rowGap}}px;"
                >
                  <view class="home__item" wx:for="{{col}}" wx:for-item="item" wx:key="_id">
                    <pack-card
                      packId="{{item._id}}"
                      title="{{item.title}}"
                      coverUrl="{{item.coverUrl}}"
                      emojiCount="{{item.emojiCount}}"
                      downloadCount="{{item.downloadCount}}"
                      categoryId="{{item.categoryId}}"
                      categoryName="{{item.categoryName}}"
                      coverRatio="{{item.coverRatio}}"
                      cardWidth="{{cardWidth}}"
                      showAdmin="{{isAdmin}}"
                      selectMode="{{selectMode}}"
                      selected="{{selectedMap[item._id] ? true : false}}"
                      bind:toggle="onTogglePack"
                      bind:ratiochange="onCoverRatioChange"
                      bind:edit="onEditPack"
                      bind:delete="onDeletePack"
                    />
                  </view>
                </view>
              </view>
              <view class="home__footer" wx:if="{{loadingMore}}">
                <fun-loading size="small" variant="wave" funTips="{{false}}" text="加载更多" />
              </view>
              <view class="home__footer" wx:elif="{{!hasMore}}">共 {{listTotal}} 个合集</view>
            </block>

            <view class="home__state" wx:elif="{{loading}}">
              <fun-loading />
            </view>

            <view class="home__state" wx:else>
              <fun-empty description="没有找到合集，试试换个关键词或分类" />
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>

  <!-- 瀑布流回到顶部：滚动超过阈值后出现，叠在 tabBar 上方 -->
  <t-back-top
    wx:if="{{!selectMode}}"
    t-class="home__back-top"
    theme="round"
    text="顶部"
    scroll-top="{{listScrollTop}}"
    visibility-height="{{backTopVisible}}"
    bind:to-top="onBackToTop"
  />

  <!-- 多选下载底栏：叠在自定义 tabBar 上方 -->
  <view class="home__batch" wx:if="{{selectMode}}">
    <view class="home__batch-meta">
      已选 {{selectedCount}} 个合集 · 约 {{approxCount}} 张 · {{approxCost}} 积分
    </view>
    <view class="home__batch-row">
      <view class="home__batch-variants">
        <t-check-tag
          size="medium"
          shape="round"
          variant="light"
          content="静态"
          checked="{{batchVariant === 'static'}}"
          data-value="static"
          bind:change="onBatchVariantTap"
        />
        <t-check-tag
          size="medium"
          shape="round"
          variant="light"
          content="动态"
          checked="{{batchVariant === 'anim'}}"
          data-value="anim"
          bind:change="onBatchVariantTap"
        />
      </view>
      <t-button
        t-class="home__batch-btn"
        size="small"
        theme="primary"
        shape="round"
        disabled="{{!selectedCount || batchSaving}}"
        loading="{{batchSaving}}"
        content="{{selectedCount ? '下载' : '请先选择'}}"
        bind:tap="onBatchDownload"
      />
    </view>
  </view>
</view>

<t-dialog
  visible="{{deleteDialogVisible}}"
  title="确认删除"
  content="确定删除「{{deleteTitle}}」？删除后不可恢复。"
  confirm-btn="删除"
  cancel-btn="取消"
  bind:confirm="onConfirmDelete"
  bind:cancel="onCancelDelete"
/>

<t-dialog
  visible="{{confirmVisible}}"
  title="{{confirmTitle}}"
  confirm-btn="{{confirmOkText}}"
  cancel-btn="取消"
  bind:confirm="onConfirmOk"
  bind:cancel="onConfirmCancel"
>
  <view slot="content" class="home__confirm">
    <image
      wx:if="{{confirmIcon}}"
      class="home__confirm-icon"
      src="{{confirmIcon}}"
      mode="aspectFit"
    />
    <text class="home__confirm-text">{{confirmContent}}</text>
  </view>
</t-dialog>

<!-- 新用户见面礼 -->
<t-popup
  visible="{{giftVisible}}"
  placement="center"
  bind:visible-change="onGiftVisibleChange"
>
  <view class="home__gift">
    <image class="home__gift-icon" src="/static/emoji/gift.png" mode="aspectFit" />
    <view class="home__gift-title">见面就送好礼！</view>
    <view class="home__gift-points">+{{giftPoints}} 积分</view>
    <view class="home__gift-desc">
      <text class="home__gift-desc-line">已放进你的账户</text>
      <text class="home__gift-desc-line">{{giftAffordLine}}</text>
    </view>
    <view class="home__gift-tip">每天还能签到领积分哦</view>
    <t-button
      theme="primary"
      size="large"
      block
      content="去签到看看"
      bind:tap="goCheckinFromGift"
    />
    <t-button
      theme="default"
      variant="text"
      size="medium"
      block
      content="先去逛逛"
      bind:tap="closeWelcomeGift"
    />
  </view>
</t-popup>

<!-- 活动发积分到账 -->
<t-popup
  visible="{{activityGiftVisible}}"
  placement="center"
  bind:visible-change="onActivityGiftVisibleChange"
>
  <view class="home__gift">
    <image class="home__gift-icon" src="/static/emoji/gift.png" mode="aspectFit" />
    <view class="home__gift-title">{{activityGiftTitle}}</view>
    <view class="home__gift-points">+{{activityGiftPoints}} 积分</view>
    <view class="home__gift-desc">
      <text class="home__gift-desc-line">已放进你的账户</text>
      <text class="home__gift-desc-line">{{activityGiftAffordLine}}</text>
    </view>
    <view class="home__gift-tip">{{activityGiftTip}}</view>
    <t-button
      theme="primary"
      size="large"
      block
      content="太棒了"
      bind:tap="closeActivityGift"
    />
  </view>
</t-popup>

<!-- 全局抽奖邀请 / 开奖结果（任意前台页可弹） -->
<lottery-host />

<!-- 微信官方订阅弹窗须用户点击后才能调起；底部引导条承接「进首页提醒」体验 -->
<t-popup
  visible="{{subscribeGuideVisible}}"
  placement="bottom"
  bind:visible-change="onSubscribeGuideVisibleChange"
>
  <view class="home__subscribe">
    <view class="home__subscribe-title">开启新合集提醒</view>
    <view class="home__subscribe-desc">
      有新表情 / 壁纸合集上线时，通过微信服务通知提醒你。可在弹窗中勾选「总是保持以上选择」。
    </view>
    <t-button
      theme="primary"
      size="large"
      block
      content="开启提醒"
      bind:tap="onSubscribeGuideConfirm"
    />
    <t-button
      theme="default"
      variant="text"
      size="medium"
      block
      content="以后再说"
      bind:tap="onSubscribeGuideLater"
    />
  </view>
</t-popup>
