<page-meta page-style="{{themeStyle}}" />
<wxs src="./refresher.wxs" module="rf" />
<view
  class="home {{selectMode ? 'home--select' : ''}} {{festivalClass}}"
  style="{{themeStyle}};{{festivalStyle}};{{navBarStyle}}"
>
  <festival-decor
    id="festivalDecor"
    mode="home"
    active="{{festivalActive}}"
    header-height="{{festHeaderPx}}"
    nav-height="{{navHeight}}"
  />
  <t-navbar
    title=""
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{500}}"
    t-class="home__navbar"
    custom-style="{{navBarStyle}}"
  >
    <view
      wx:if="{{!searchExpanded}}"
      slot="title"
      class="home__brand"
      hover-class="home__brand--press"
      hover-start-time="20"
      hover-stay-time="80"
      catchtap="onBrandTap"
      aria-role="button"
      aria-label="趣图铺子，查看更新说明"
    >
      <image
        class="home__brand-logo"
        src="/static/brand/logo.png"
        mode="aspectFill"
        aria-hidden="true"
      />
      <text class="home__brand-name">趣图铺子</text>
      <view wx:if="{{whatsNewBadge}}" class="home__brand-dot" aria-hidden="true" />
    </view>
  </t-navbar>
  <!-- 搜索抬到导航行：展开用 left+right 限位，右缘停在「多选」左侧 -->
  <view
    class="home__search {{searchExpanded ? 'home__search--open' : ''}}"
    style="{{searchBoxStyle}}"
  >
    <view
      class="home__search-fab"
      style="width: {{searchBarHeight}}px; height: {{searchBarHeight}}px;"
      hover-class="home__search-fab--press"
      bindtap="openSearch"
      aria-role="button"
      aria-label="搜索"
    >
      <kubai-icon name="zoom-in" size="{{searchIconSize}}" color="{{themeBrand}}" />
      <view wx:if="{{keyword && !searchExpanded}}" class="home__search-dot" aria-hidden="true" />
    </view>
    <view class="home__search-panel" style="height: {{searchBarHeight}}px;">
      <view
        class="home__search-collapse"
        style="height: {{searchBarHeight}}px;"
        hover-class="home__search-collapse--press"
        catchtap="closeSearch"
        aria-role="button"
        aria-label="收起搜索"
      >
        <kubai-icon name="chevron-left" size="{{searchIconSize}}" color="{{themeBrand}}" />
      </view>
      <t-search
        t-class="home__search-input"
        value="{{keyword}}"
        shape="round"
        placeholder="搜索标题 / 简介 / 分类"
        clearable
        focus="{{searchFocus}}"
        bind:change="onSearchChange"
        bind:submit="onSearchSubmit"
        bind:clear="onSearchClear"
        bind:blur="onSearchBlur"
      />
    </view>
  </view>
  <view class="home__fixed" style="top: {{navHeight}}px;">
    <!-- 左：类型胶囊 · 中：主题 Tab · 右：多选（让出顶栏给品牌标题） -->
    <view class="home__filter-bar">
      <view
        class="home__type-capsule"
        style="{{contentTypeChipStyle}}"
        hover-class="home__type-capsule--press"
        hover-stay-time="60"
        bindtap="openContentTypeSheet"
        aria-role="button"
        aria-label="选择合集类型"
      >
        <image
          class="home__type-capsule-icon"
          src="{{contentTypeIconSrc}}"
          mode="aspectFit"
        />
        <text class="home__type-capsule-text">{{contentTypeName}}</text>
        <!-- currentColor 跟胶囊文字同色，随类型变绿/紫/蓝/粉 -->
        <view class="home__type-capsule-caret" aria-hidden="true" />
      </view>
      <scroll-view
        id="homeToolbar"
        class="home__toolbar"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        enable-flex
        scroll-with-animation
        scroll-left="{{catScrollLeft}}"
      >
        <view class="home__toolbar-inner home__toolbar-inner--cats">
          <view
            wx:for="{{filters}}"
            wx:key="id"
            id="cat-{{item.id}}"
            class="home__tab {{item.id === categoryId ? 'home__tab--on' : ''}}"
            style="{{item.tabStyle}}"
            hover-class="home__tab--press"
            hover-stay-time="60"
            data-id="{{item.id}}"
            bindtap="onCategoryTap"
          >
            <text class="home__tab-name">{{item.name}}</text>
            <text
              class="home__tab-count {{item.id === categoryId ? 'home__tab-count--show' : ''}}"
            >{{item.id === categoryId ? listTotal : ''}}</text>
            <view class="home__tab-bar" aria-hidden="true" />
          </view>
        </view>
      </scroll-view>
      <view
        class="home__select-toggle {{selectMode ? 'home__select-toggle--on' : ''}}"
        hover-class="home__select-toggle--press"
        hover-stay-time="60"
        bindtap="onToggleSelectMode"
        aria-role="button"
      >{{selectMode ? '取消' : '多选'}}</view>
    </view>
  </view>

  <view
    class="home__body"
    style="padding-top: {{fixedOffset}}px;"
  >
    <view class="home__swipe-stage">
      <view
        class="home__pane"
        style="padding-left: {{listGap}}px; padding-right: {{listGap}}px;"
      >
        <view class="home__pane-inner">
          <scroll-view
            class="home__scroller"
            style="height: {{scrollerHeight}}px;"
            scroll-y
            enhanced
            show-scrollbar="{{false}}"
            bounces="{{false}}"
            scroll-top="{{scrollerTop}}"
            scroll-into-view="{{scrollerIntoView}}"
            scroll-with-animation
            refresher-enabled
            refresher-threshold="{{80}}"
            refresher-default-style="none"
            refresher-triggered="{{enable}}"
            refresher-ballistic-refresh-enabled="{{false}}"
            lower-threshold="{{160}}"
            bindrefresherpulling="{{rf.onPulling}}"
            bindrefresherrefresh="onRefresh"
            bindrefresherrestore="{{rf.onRestore}}"
            bindrefresherabort="{{rf.onAbort}}"
            bindscrolltolower="onScrollToLower"
            bindscroll="onListScroll"
          >
            <!--
              下拉过程文案用 WXS 切，勿在 pulling 里 setData，
              否则真机常见：停手后 refresher 仍继续往下窜。
            -->
            <view slot="refresher" class="home__refresher">
              <fun-loading
                size="small"
                variant="wave"
                funTips="{{false}}"
                text="{{enable ? '正在刷新' : ''}}"
              />
              <view wx:if="{{!enable}}" class="js-rf-pull home__refresher-text">下拉刷新</view>
              <view
                wx:if="{{!enable}}"
                class="js-rf-release home__refresher-text"
                style="display: none;"
              >松手刷新</view>
            </view>
            <view id="homeScrollerTop" class="home__scroller-anchor" />
            <view
              wx:if="{{!selectMode}}"
              class="home__lib-banner"
              catchtap="goLibrary"
              hover-class="home__lib-banner--press"
              hover-start-time="20"
              hover-stay-time="80"
            >
              <view class="home__lib-banner-main">
                <view class="home__lib-banner-head">
                  <text class="home__lib-banner-title">发现更多有趣素材</text>
                  <t-tag size="small" variant="light" theme="danger">NEW</t-tag>
                </view>
                <text class="home__lib-banner-desc">表情 · 梗图 · 动图 · 静图</text>
                <view class="home__lib-banner-cta">
                  <text>进入素材库</text>
                  <text class="cta-arrow">→</text>
                </view>
              </view>
              <view
                wx:if="{{libBannerThumbs.length}}"
                class="home__lib-banner-thumbs"
                aria-hidden="true"
              >
                <view
                  wx:for="{{libBannerThumbs}}"
                  wx:key="url"
                  class="home__lib-banner-thumb"
                >
                  <smart-image
                    src="{{item.url}}"
                    file-id="{{item.fileId}}"
                    mode="aspectFill"
                    shape="round"
                    lazy
                    radius="16rpx"
                    transparent
                  />
                </view>
              </view>
            </view>

            <!-- 搜索命中素材库（与合集列表并行，轻量横滑） -->
            <view
              wx:if="{{!selectMode && keyword && (libSearchHits.length || libSearchLoading)}}"
              class="home__lib-hits"
            >
              <view class="home__lib-hits-head">
                <text class="home__lib-hits-title">素材库</text>
                <text wx:if="{{libSearchLoading}}" class="home__lib-hits-meta">搜索中…</text>
                <text
                  wx:elif="{{libSearchHits.length}}"
                  class="home__lib-hits-more"
                  catchtap="goLibrarySearchMore"
                >更多</text>
              </view>
              <scroll-view
                wx:if="{{libSearchHits.length}}"
                class="home__lib-hits-scroll"
                scroll-x
                enhanced
                show-scrollbar="{{false}}"
                enable-flex
              >
                <view class="home__lib-hits-row">
                  <view
                    wx:for="{{libSearchHits}}"
                    wx:key="_id"
                    class="home__lib-hit"
                    data-id="{{item._id}}"
                    data-sourceid="{{item.sourceId}}"
                    bindtap="onLibSearchTap"
                    hover-class="home__lib-hit--press"
                    hover-start-time="20"
                    hover-stay-time="80"
                  >
                    <view class="home__lib-hit-thumb">
                      <smart-image
                        wx:if="{{item.previewUrl}}"
                        src="{{item.previewUrl}}"
                        file-id="{{item.previewFileID}}"
                        mode="aspectFill"
                        shape="round"
                        lazy
                        radius="20rpx"
                        transparent
                      />
                    </view>
                    <text class="home__lib-hit-name">{{item.name}}</text>
                    <text class="home__lib-hit-src">{{item.sourceTitle}}</text>
                  </view>
                </view>
              </scroll-view>
            </view>

            <block wx:if="{{!loading && list.length}}">
              <view class="home__feed" style="gap: {{rowGap}}px;">
                <block wx:for="{{feedBlocks}}" wx:key="key">
                  <!-- 表情 / 头像：四预览行（与上方 pane 左右 padding 对齐，不再叠一层） -->
                  <view
                    wx:if="{{item.type === 'row' && item.pack}}"
                    class="home__pack-row {{item.pack.moodId ? 'home__pack-row--mood-' + item.pack.moodId : ''}} {{selectMode && selectedMap[item.pack._id] ? 'home__pack-row--selected' : ''}} {{selectMode && batchContentType && (item.pack.contentType || 'emoji') !== batchContentType && !selectedMap[item.pack._id] ? 'home__pack-row--disabled' : ''}}"
                    data-id="{{item.pack._id}}"
                    bindtap="onOpenPackRow"
                    hover-class="home__pack-row--press"
                    hover-start-time="20"
                    hover-stay-time="80"
                  >
                    <!-- 氛围：右上角原比例 GIF + screen 去黑底（不拉伸、无整卡铺满） -->
                    <view
                      wx:if="{{item.pack.mood.overlay}}"
                      class="home__pack-row-mood"
                      aria-hidden="true"
                    >
                      <image
                        class="home__pack-row-mood-img"
                        style="{{item.pack.mood.boxStyle}}"
                        src="{{item.pack.mood.overlay}}"
                        mode="aspectFit"
                        lazy-load
                      />
                    </view>

                    <view class="home__pack-row-body">
                      <view class="home__pack-row-head">
                        <view class="home__pack-row-title-wrap">
                          <view
                            wx:if="{{selectMode}}"
                            class="home__pack-row-check {{selectedMap[item.pack._id] ? 'is-on' : ''}}"
                          />
                          <text class="home__pack-row-title">{{item.pack.title}}</text>
                          <view
                            wx:if="{{item.pack.categoryName}}"
                            class="home__pack-row-cat"
                          >
                            <t-tag
                              size="small"
                              theme="default"
                              variant="light"
                              custom-style="{{item.pack.categoryTagStyle}}"
                            >{{item.pack.categoryName}}</t-tag>
                          </view>
                          <text
                            wx:if="{{isAdmin}}"
                            class="home__pack-row-meta"
                          >下载 {{item.pack.downloadCount || 0}}</text>
                        </view>
                        <view wx:if="{{item.pack.mood}}" class="home__pack-row-mood-badge">
                          <kubai-icon
                            name="{{item.pack.mood.icon}}"
                            size="26rpx"
                            color="{{item.pack.mood.iconColor}}"
                            motion="{{false}}"
                          />
                          <text>{{item.pack.mood.label}}</text>
                        </view>
                        <text wx:else class="home__pack-row-more">更多</text>
                      </view>
                      <view
                        class="home__pack-row-grid"
                        style="grid-template-columns: repeat({{previewRowCount}}, 1fr);"
                      >
                        <view
                          wx:for="{{item.pack.previewSlots}}"
                          wx:for-item="slot"
                          wx:for-index="ti"
                          wx:key="key"
                          class="home__pack-row-cell"
                        >
                          <smart-image
                            src="{{slot.url}}"
                            file-id="{{slot.fileID}}"
                            cache-key="{{slot.cacheKey}}"
                            mode="aspectFill"
                            shape="round"
                            lazy
                            webp
                            radius="14rpx"
                            transparent
                            data-pack-id="{{item.pack._id}}"
                            data-index="{{ti}}"
                            bind:resign="onPreviewResign"
                          />
                          <view
                            wx:if="{{slot.showMore && item.pack.moreCount > 0}}"
                            class="home__pack-row-moremask"
                          >+{{item.pack.moreCount}}</view>
                        </view>
                      </view>
                    </view>
                  </view>

                  <!-- 混合流中的单张壁纸卡 -->
                  <view wx:elif="{{item.type === 'card' && item.pack}}" class="home__feed-card">
                    <pack-card
                      packId="{{item.pack._id}}"
                      title="{{item.pack.title}}"
                      coverUrl="{{item.pack.coverUrl}}"
                      coverFileID="{{item.pack.coverFileID}}"
                      contentType="{{item.pack.contentType}}"
                      emojiCount="{{item.pack.emojiCount}}"
                      downloadCount="{{item.pack.downloadCount}}"
                      categoryId="{{item.pack.categoryId}}"
                      categoryName="{{item.pack.categoryName}}"
                      coverRatio="{{item.pack.coverRatio}}"
                      cardWidth="{{fullCardWidth || cardWidth}}"
                      showAdmin="{{isAdmin}}"
                      showTypeBadge="{{contentType === 'all'}}"
                      selectMode="{{selectMode}}"
                      selected="{{selectedMap[item.pack._id] ? true : false}}"
                      selectDisabled="{{selectMode && batchContentType && (item.pack.contentType || 'emoji') !== batchContentType && !selectedMap[item.pack._id]}}"
                      bind:toggle="onTogglePack"
                      bind:ratiochange="onCoverRatioChange"
                      bind:covererror="onCoverError"
                      bind:edit="onEditPack"
                      bind:delete="onDeletePack"
                    />
                  </view>

                  <!-- 纯壁纸：两列封面网格（可夹广告） -->
                  <view
                    wx:elif="{{item.type === 'wall-grid'}}"
                    class="home__wall-grid"
                    style="gap: {{listGap}}px;"
                  >
                    <block wx:for="{{item.packs}}" wx:for-item="pack" wx:key="_id">
                      <view
                        wx:if="{{!pack.isAd}}"
                        class="home__wall-cell"
                        style="width: {{cardWidth}}px;"
                      >
                        <pack-card
                          packId="{{pack._id}}"
                          title="{{pack.title}}"
                          coverUrl="{{pack.coverUrl}}"
                          coverFileID="{{pack.coverFileID}}"
                          contentType="{{pack.contentType}}"
                          emojiCount="{{pack.emojiCount}}"
                          downloadCount="{{pack.downloadCount}}"
                          categoryId="{{pack.categoryId}}"
                          categoryName="{{pack.categoryName}}"
                          coverRatio="{{pack.coverRatio}}"
                          cardWidth="{{cardWidth}}"
                          showAdmin="{{isAdmin}}"
                          showTypeBadge="{{false}}"
                          selectMode="{{selectMode}}"
                          selected="{{selectedMap[pack._id] ? true : false}}"
                          selectDisabled="{{selectMode && batchContentType && (pack.contentType || 'emoji') !== batchContentType && !selectedMap[pack._id]}}"
                          bind:toggle="onTogglePack"
                          bind:ratiochange="onCoverRatioChange"
                          bind:covererror="onCoverError"
                          bind:edit="onEditPack"
                          bind:delete="onDeletePack"
                        />
                      </view>
                      <view
                        wx:elif="{{!pack.hidden && showFeedAds && !selectMode && nativeAdUnitId}}"
                        class="home__feed-ad-banner"
                        style="width: 100%;"
                      >
                        <ad-custom
                          unit-id="{{nativeAdUnitId}}"
                          data-key="{{pack.key}}"
                          binderror="onFeedAdError"
                        />
                      </view>
                    </block>
                  </view>

                  <!-- 通栏广告 -->
                  <view
                    wx:elif="{{item.type === 'ad' && !item.hidden && showFeedAds && !selectMode && nativeAdUnitId}}"
                    class="home__feed-ad-banner"
                  >
                    <ad-custom
                      unit-id="{{nativeAdUnitId}}"
                      data-key="{{item.key}}"
                      binderror="onFeedAdError"
                    />
                  </view>
                </block>
              </view>
              <view class="home__footer" wx:if="{{loadingMore}}">
                <fun-loading size="small" variant="wave" funTips="{{false}}" text="加载更多" />
              </view>
              <view class="home__footer" wx:elif="{{!hasMore}}">共 {{listTotal}} 个合集</view>
            </block>

            <view class="home__state" wx:elif="{{loading}}">
              <fun-loading />
            </view>

            <view class="home__state" wx:else>
              <fun-empty description="没有找到合集，试试换个关键词或分类" />
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>

  <!-- 瀑布流回到顶部：滚动超过阈值后出现，叠在 tabBar 上方 -->
  <t-back-top
    wx:if="{{!selectMode}}"
    t-class="home__back-top"
    theme="round"
    text="顶部"
    scroll-top="{{listScrollTop}}"
    visibility-height="{{backTopVisible}}"
    bind:to-top="onBackToTop"
  />

  <!-- 多选下载底栏：叠在自定义 tabBar 上方；同一次只能选同一类型 -->
  <view class="home__batch" wx:if="{{selectMode}}">
    <view class="home__batch-meta">
      <kubai-icon name="image-down" size="28rpx" color="{{themeBrand}}" />
      <text>{{batchMetaText}}</text>
    </view>
    <view class="home__batch-row">
      <view class="home__batch-variants" wx:if="{{batchShowVariant}}">
        <t-check-tag
          size="medium"
          shape="round"
          variant="light"
          content="静态"
          checked="{{batchVariant === 'static'}}"
          data-value="static"
          bind:change="onBatchVariantTap"
        />
        <t-check-tag
          size="medium"
          shape="round"
          variant="light"
          content="动态"
          checked="{{batchVariant === 'anim'}}"
          data-value="anim"
          bind:change="onBatchVariantTap"
        />
      </view>
      <view
        class="home__batch-type"
        wx:elif="{{batchTypeName}}"
        style="{{batchContentTypeColorStyle}}"
      >
        <image
          class="home__batch-type-icon"
          src="{{batchContentTypeIconSrc}}"
          mode="aspectFit"
        />
        <text>{{batchTypeName}}合集</text>
      </view>
      <t-button
        t-class="home__batch-btn"
        size="small"
        theme="primary"
        shape="round"
        disabled="{{!selectedCount || batchSaving}}"
        loading="{{batchSaving}}"
        content="{{selectedCount ? '下载' : '请先选择'}}"
        bind:tap="onBatchDownload"
      />
    </view>
  </view>
</view>

<t-dialog
  visible="{{deleteDialogVisible}}"
  title="确认删除"
  content="确定删除「{{deleteTitle}}」？删除后不可恢复。"
  confirm-btn="删除"
  cancel-btn="取消"
  bind:confirm="onConfirmDelete"
  bind:cancel="onCancelDelete"
/>

<t-dialog
  visible="{{confirmVisible}}"
  title="{{confirmTitle}}"
  confirm-btn="{{confirmOkText}}"
  cancel-btn="取消"
  bind:confirm="onConfirmOk"
  bind:cancel="onConfirmCancel"
>
  <view slot="content" class="home__confirm">
    <image
      wx:if="{{confirmIcon}}"
      class="home__confirm-icon"
      src="{{confirmIcon}}"
      mode="aspectFit"
    />
    <text class="home__confirm-text">{{confirmContent}}</text>
  </view>
</t-dialog>

<!-- 版本更新说明（全部历史；升级时展示旧 → 新） -->
<t-popup
  visible="{{whatsNewVisible}}"
  placement="center"
  bind:visible-change="onWhatsNewVisibleChange"
>
  <view class="home__whats-new">
    <view class="home__whats-new-title">
      <kubai-icon name="sparkles" size="40rpx" color="#f59e0b" />
      <text>{{whatsNewTitle}}</text>
    </view>

    <view wx:if="{{whatsNewShowUpgrade}}" class="home__whats-new-upgrade">
      <view class="home__whats-new-pill home__whats-new-pill--from">
        v{{whatsNewFromVersion}}
      </view>
      <view class="home__whats-new-arrow" aria-hidden="true">
        <kubai-icon name="chevron-right" size="28rpx" color="#00b853" />
      </view>
      <view class="home__whats-new-pill home__whats-new-pill--to">
        v{{whatsNewVersion}}
      </view>
    </view>
    <view wx:elif="{{whatsNewVersion}}" class="home__whats-new-ver">
      v{{whatsNewVersion}}
    </view>

    <scroll-view
      class="home__whats-new-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <view
        wx:for="{{whatsNewReleases}}"
        wx:key="version"
        class="home__whats-new-release {{item.isCurrent ? 'home__whats-new-release--current' : ''}}"
      >
        <view class="home__whats-new-release-head">
          <text class="home__whats-new-release-ver">v{{item.version}}</text>
          <text wx:if="{{item.isCurrent}}" class="home__whats-new-release-tag">当前</text>
        </view>
        <view class="home__whats-new-list">
          <view
            wx:for="{{item.items}}"
            wx:for-item="line"
            wx:for-index="lineIdx"
            wx:key="lineIdx"
            class="home__whats-new-item"
          >
            <text class="home__whats-new-num">{{lineIdx + 1}}.</text>
            <text class="home__whats-new-text">{{line}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <t-button
      theme="primary"
      size="large"
      block
      content="知道了"
      bind:tap="closeWhatsNew"
    />
  </view>
</t-popup>

<!-- 新用户见面礼 -->
<t-popup
  visible="{{giftVisible}}"
  placement="center"
  bind:visible-change="onGiftVisibleChange"
>
  <view class="home__gift">
    <image class="home__gift-icon" src="/static/emoji/gift.png" mode="aspectFit" />
    <view class="home__gift-title">
      <kubai-icon name="sparkles" size="40rpx" color="#f59e0b" />
      <text>见面就送好礼！</text>
    </view>
    <view class="home__gift-points">+{{giftPoints}} 积分</view>
    <view class="home__gift-desc">
      <text class="home__gift-desc-line">已放进你的账户</text>
      <text class="home__gift-desc-line">{{giftAffordLine}}</text>
    </view>
    <view class="home__gift-tip">每天还能签到领积分哦</view>
    <t-button
      theme="primary"
      size="large"
      block
      content="去签到看看"
      bind:tap="goCheckinFromGift"
    />
    <t-button
      theme="default"
      variant="text"
      size="medium"
      block
      content="先去逛逛"
      bind:tap="closeWelcomeGift"
    />
  </view>
</t-popup>

<!-- 活动发积分到账 -->
<t-popup
  visible="{{activityGiftVisible}}"
  placement="center"
  bind:visible-change="onActivityGiftVisibleChange"
>
  <view class="home__gift">
    <image class="home__gift-icon" src="/static/emoji/gift.png" mode="aspectFit" />
    <view class="home__gift-title">
      <kubai-icon name="sparkles" size="40rpx" color="#f59e0b" />
      <text>{{activityGiftTitle}}</text>
    </view>
    <view class="home__gift-points">+{{activityGiftPoints}} 积分</view>
    <view class="home__gift-desc">
      <text class="home__gift-desc-line">已放进你的账户</text>
      <text class="home__gift-desc-line">{{activityGiftAffordLine}}</text>
    </view>
    <view class="home__gift-tip">{{activityGiftTip}}</view>
    <t-button
      theme="primary"
      size="large"
      block
      content="太棒了"
      bind:tap="closeActivityGift"
    />
  </view>
</t-popup>

<!-- 全局抽奖邀请 / 开奖结果（任意前台页可弹） -->
<lottery-host />
<points-reward id="pointsReward" />

<!-- 微信官方订阅弹窗须用户点击后才能调起；底部引导条承接「进首页提醒」体验 -->
<t-popup
  visible="{{subscribeGuideVisible}}"
  placement="bottom"
  bind:visible-change="onSubscribeGuideVisibleChange"
>
  <view class="home__subscribe">
    <view class="home__subscribe-title">开启新合集提醒</view>
    <view class="home__subscribe-desc">
      有新表情 / 壁纸 / 头像 / 视频合集上线时，通过微信服务通知提醒你。可在弹窗中勾选「总是保持以上选择」。
    </view>
    <t-button
      theme="primary"
      size="large"
      block
      content="开启提醒"
      bind:tap="onSubscribeGuideConfirm"
    />
    <t-button
      theme="default"
      variant="text"
      size="medium"
      block
      content="以后再说"
      bind:tap="onSubscribeGuideLater"
    />
  </view>
</t-popup>

<t-popup
  visible="{{contentTypeSheetVisible}}"
  placement="bottom"
  bind:visible-change="onContentTypeSheetVisibleChange"
>
  <view class="home__type-sheet">
    <view class="home__type-sheet-title">
      <kubai-icon name="layout-dashboard" size="40rpx" color="{{themeBrand}}" />
      <text>筛选合集类型</text>
    </view>
    <view class="home__type-sheet-tip">表情 / 壁纸 / 头像 / 视频</view>
    <view
      wx:for="{{contentTypeFilters}}"
      wx:key="id"
      class="home__type-sheet-item {{item.id === contentType ? 'home__type-sheet-item--on' : ''}}"
      style="{{item.id === contentType ? item.chipStyle : item.textStyle}}"
      hover-class="home__type-sheet-item--press"
      hover-start-time="20"
      hover-stay-time="150"
      data-id="{{item.id}}"
      bindtap="onContentTypeSheetPick"
    >
      <image
        class="home__type-sheet-icon"
        src="{{item.iconSrc}}"
        mode="aspectFit"
      />
      <text class="home__type-sheet-label">{{item.name}}</text>
      <kubai-icon
        wx:if="{{item.id === contentType}}"
        name="check"
        size="48rpx"
        color="{{item.color}}"
      />
    </view>
    <t-button
      theme="default"
      variant="outline"
      size="large"
      block
      shape="round"
      content="取消"
      bind:tap="closeContentTypeSheet"
    />
  </view>
</t-popup>
