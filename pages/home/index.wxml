<view class="home {{selectMode ? 'home--select' : ''}}" style="{{themeStyle}}">
  <t-navbar title="趣集" placeholder="{{true}}" z-index="{{500}}" t-class="home__navbar" />
  <!-- 本版 t-navbar 无 right 插槽，贴胶囊左侧放多选/取消 -->
  <view
    class="home__nav-action"
    style="top: {{menuButton.top}}px; height: {{menuButton.height}}px; right: {{menuButton.gap}}px;"
    hover-class="home__nav-action--press"
    hover-stay-time="60"
    bindtap="onToggleSelectMode"
  >{{selectMode ? '取消' : '多选'}}</view>

  <!-- 搜索放进分类同一滚动行，避免与 scroll-view 兄弟节点垂直错位 -->
  <view class="home__fixed" style="top: {{navHeight}}px;">
    <scroll-view
      class="home__toolbar"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      enable-flex
    >
      <view class="home__toolbar-inner">
        <view class="home__search {{searchExpanded ? 'home__search--open' : ''}}">
          <view
            class="home__search-fab"
            hover-class="home__search-fab--press"
            bindtap="openSearch"
            aria-role="button"
            aria-label="搜索"
          >
            <t-icon name="search" size="32rpx" />
            <view wx:if="{{keyword && !searchExpanded}}" class="home__search-dot" aria-hidden="true" />
          </view>
          <view class="home__search-panel">
            <view
              class="home__search-collapse"
              hover-class="home__search-collapse--press"
              catchtap="closeSearch"
              aria-role="button"
              aria-label="收起搜索"
            >
              <t-icon name="chevron-left" size="32rpx" />
            </view>
            <t-search
              t-class="home__search-input"
              value="{{keyword}}"
              shape="round"
              placeholder="搜索合集"
              clearable
              focus="{{searchFocus}}"
              bind:change="onSearchChange"
              bind:submit="onSearchSubmit"
              bind:clear="onSearchClear"
              bind:blur="onSearchBlur"
            />
          </view>
        </view>
        <t-check-tag
          wx:for="{{filters}}"
          wx:key="id"
          t-class="home__cat"
          size="medium"
          shape="round"
          variant="light"
          content=""
          checked="{{item.id === categoryId}}"
          data-id="{{item.id}}"
          bind:change="onCategoryTap"
        >
          <view class="home__cat-inner">
            <text class="home__cat-name">{{item.name}}</text>
            <text
              class="home__cat-count {{item.id === categoryId ? 'home__cat-count--show' : ''}}"
            >{{item.id === categoryId ? listTotal : item.count}}</text>
          </view>
        </t-check-tag>
      </view>
    </scroll-view>
  </view>

  <view
    class="home__body"
    style="padding-top: {{fixedOffset}}px; padding-left: {{listGap}}px; padding-right: {{listGap}}px;"
  >
    <t-pull-down-refresh
      value="{{enable}}"
      lower-threshold="{{160}}"
      bind:refresh="onRefresh"
      bind:scrolltolower="onScrollToLower"
      loadingTexts="{{['下拉刷新', '松手刷新', '正在刷新', '刷新完成']}}"
    >
      <block wx:if="{{!loading && list.length}}">
        <view class="home__list" style="gap: {{listGap}}px;">
          <view
            class="home__col"
            wx:for="{{columns}}"
            wx:for-item="col"
            wx:for-index="colIndex"
            wx:key="colIndex"
            style="width: {{cardWidth}}px; gap: {{rowGap}}px;"
          >
            <view class="home__item" wx:for="{{col}}" wx:for-item="item" wx:key="_id">
              <pack-card
                packId="{{item._id}}"
                title="{{item.title}}"
                coverUrl="{{item.coverUrl}}"
                emojiCount="{{item.emojiCount}}"
                downloadCount="{{item.downloadCount}}"
                categoryId="{{item.categoryId}}"
                categoryName="{{item.categoryName}}"
                coverRatio="{{item.coverRatio}}"
                cardWidth="{{cardWidth}}"
                showAdmin="{{isAdmin}}"
                selectMode="{{selectMode}}"
                selected="{{selectedMap[item._id] ? true : false}}"
                bind:toggle="onTogglePack"
                bind:edit="onEditPack"
                bind:delete="onDeletePack"
              />
            </view>
          </view>
        </view>
        <view class="home__footer" wx:if="{{loadingMore}}">
          <fun-loading size="small" variant="wave" funTips="{{false}}" text="加载更多" />
        </view>
        <view class="home__footer" wx:elif="{{!hasMore}}">共 {{listTotal}} 个合集</view>
      </block>

      <view class="home__state" wx:elif="{{loading}}">
        <fun-loading />
      </view>

      <view class="home__state" wx:else>
        <t-empty
          t-class="home__empty"
          t-class-image="home__empty-img"
          image="/static/emoji/search.png"
          description="没有找到合集，试试换个关键词或分类"
        />
      </view>
    </t-pull-down-refresh>
  </view>

  <!-- 多选下载底栏：叠在自定义 tabBar 上方 -->
  <view class="home__batch" wx:if="{{selectMode}}">
    <view class="home__batch-meta">
      已选 {{selectedCount}} 个合集 · 约 {{approxCount}} 张 · {{approxCost}} 积分
    </view>
    <view class="home__batch-row">
      <view class="home__batch-variants">
        <t-check-tag
          size="medium"
          shape="round"
          variant="light"
          content="静态"
          checked="{{batchVariant === 'static'}}"
          data-value="static"
          bind:change="onBatchVariantTap"
        />
        <t-check-tag
          size="medium"
          shape="round"
          variant="light"
          content="动态"
          checked="{{batchVariant === 'anim'}}"
          data-value="anim"
          bind:change="onBatchVariantTap"
        />
      </view>
      <t-button
        t-class="home__batch-btn"
        size="small"
        theme="primary"
        shape="round"
        disabled="{{!selectedCount || batchSaving}}"
        loading="{{batchSaving}}"
        content="{{selectedCount ? '下载' : '请先选择'}}"
        bind:tap="onBatchDownload"
      />
    </view>
  </view>
</view>

<t-dialog
  visible="{{deleteDialogVisible}}"
  title="确认删除"
  content="确定删除「{{deleteTitle}}」？删除后不可恢复。"
  confirm-btn="删除"
  cancel-btn="取消"
  bind:confirm="onConfirmDelete"
  bind:cancel="onCancelDelete"
/>

<t-dialog
  visible="{{confirmVisible}}"
  title="{{confirmTitle}}"
  confirm-btn="{{confirmOkText}}"
  cancel-btn="取消"
  bind:confirm="onConfirmOk"
  bind:cancel="onConfirmCancel"
>
  <view slot="content" class="home__confirm">
    <image
      wx:if="{{confirmIcon}}"
      class="home__confirm-icon"
      src="{{confirmIcon}}"
      mode="aspectFit"
    />
    <text class="home__confirm-text">{{confirmContent}}</text>
  </view>
</t-dialog>

<!-- 新用户见面礼 -->
<t-popup
  visible="{{giftVisible}}"
  placement="center"
  bind:visible-change="onGiftVisibleChange"
>
  <view class="home__gift">
    <image class="home__gift-icon" src="/static/emoji/gift.png" mode="aspectFit" />
    <view class="home__gift-title">见面就送好礼！</view>
    <view class="home__gift-points">+{{giftPoints}} 积分</view>
    <view class="home__gift-desc">
      <text class="home__gift-desc-line">已放进你的账户</text>
      <text class="home__gift-desc-line">{{giftAffordLine}}</text>
    </view>
    <view class="home__gift-tip">每天还能签到领积分哦</view>
    <t-button
      theme="primary"
      size="large"
      block
      content="去签到看看"
      bind:tap="goCheckinFromGift"
    />
    <t-button
      theme="default"
      variant="text"
      size="medium"
      block
      content="先去逛逛"
      bind:tap="closeWelcomeGift"
    />
  </view>
</t-popup>

<!-- 活动发积分到账 -->
<t-popup
  visible="{{activityGiftVisible}}"
  placement="center"
  bind:visible-change="onActivityGiftVisibleChange"
>
  <view class="home__gift">
    <image class="home__gift-icon" src="/static/emoji/gift.png" mode="aspectFit" />
    <view class="home__gift-title">{{activityGiftTitle}}</view>
    <view class="home__gift-points">+{{activityGiftPoints}} 积分</view>
    <view class="home__gift-desc">
      <text class="home__gift-desc-line">已放进你的账户</text>
      <text class="home__gift-desc-line">{{activityGiftAffordLine}}</text>
    </view>
    <view class="home__gift-tip">{{activityGiftTip}}</view>
    <t-button
      theme="primary"
      size="large"
      block
      content="太棒了"
      bind:tap="closeActivityGift"
    />
  </view>
</t-popup>

<!-- 全局抽奖邀请 / 开奖结果（任意前台页可弹） -->
<lottery-host />

<!-- 微信官方订阅弹窗须用户点击后才能调起；底部引导条承接「进首页提醒」体验 -->
<t-popup
  visible="{{subscribeGuideVisible}}"
  placement="bottom"
  bind:visible-change="onSubscribeGuideVisibleChange"
>
  <view class="home__subscribe">
    <view class="home__subscribe-title">开启新合集提醒</view>
    <view class="home__subscribe-desc">
      有新表情 / 壁纸合集上线时，通过微信服务通知提醒你。可在弹窗中勾选「总是保持以上选择」。
    </view>
    <t-button
      theme="primary"
      size="large"
      block
      content="开启提醒"
      bind:tap="onSubscribeGuideConfirm"
    />
    <t-button
      theme="default"
      variant="text"
      size="medium"
      block
      content="以后再说"
      bind:tap="onSubscribeGuideLater"
    />
  </view>
</t-popup>
