<view class="users-page" style="{{themeStyle}}">
  <view class="users-page__tip">点选用户管理包月 / 积分，查看流水与下载合集。共 <text class="users-page__tip-count">{{total}}</text> 人。</view>

  <view class="users-page__search-wrap">
    <t-search
      value="{{keyword}}"
      shape="round"
      placeholder="搜索昵称 / openid"
      clearable
      bind:change="onKeywordChange"
      bind:submit="onSearchSubmit"
      bind:clear="onSearchClear"
    />
  </view>

  <view class="users-page__filters">
    <t-check-tag
      size="medium"
      variant="dark"
      checked="{{filter === 'all'}}"
      content="全部"
      data-filter="all"
      bind:change="onFilterChange"
    />
    <t-check-tag
      size="medium"
      variant="dark"
      checked="{{filter === 'vip'}}"
      content="包月"
      data-filter="vip"
      bind:change="onFilterChange"
    />
    <t-check-tag
      size="medium"
      variant="dark"
      checked="{{filter === 'points'}}"
      content="有积分"
      data-filter="points"
      bind:change="onFilterChange"
    />
  </view>

  <view class="users-page__state" wx:if="{{listLoading && !list.length}}">
    <t-loading theme="circular" size="48rpx" text="加载中" />
  </view>

  <block wx:elif="{{list.length}}">
    <view
      class="users-page__item"
      wx:for="{{list}}"
      wx:key="openid"
      data-index="{{index}}"
      bindtap="onSelectUser"
    >
      <t-avatar
        t-class="users-page__avatar"
        image="{{item.avatarUrl}}"
        icon="user"
        size="88rpx"
        shape="circle"
        data-index="{{index}}"
        bind:error="onListAvatarError"
      />
      <view class="users-page__meta">
        <view class="users-page__name-row">
          <text class="users-page__name">{{item.nickName || '未设置昵称'}}</text>
          <t-tag wx:if="{{item.isAdmin}}" size="small" theme="danger" variant="light">管理员</t-tag>
          <t-tag wx:if="{{item.entitlement.isVip}}" size="small" theme="warning" variant="light">包月</t-tag>
        </view>
        <view class="users-page__sub">{{item.statusText}} · 积分 {{item.entitlement.points}} 分{{item.entitlement.isVip ? ' · 本月额度 ' + item.entitlement.vipMonthQuota + ' 分' : ''}} · <text class="users-page__paid {{item.paidFen > 0 ? 'users-page__paid--on' : ''}}">{{item.paidText}}</text></view>
        <view class="users-page__sub">{{item.shortId}}{{item.lastLoginText ? ' · ' + item.lastLoginText : ''}}</view>
      </view>
      <t-icon name="chevron-right" size="36rpx" />
    </view>
    <view class="users-page__footer">
      {{listHasMore ? (listLoading ? '加载中...' : '上拉加载更多') : '没有更多了'}}
    </view>
  </block>

  <view class="users-page__state" wx:else>
    <fun-empty description="暂无用户" />
  </view>

  <t-popup visible="{{panelVisible}}" placement="bottom" bind:visible-change="onPopupChange">
    <view class="users-panel" wx:if="{{user}}">
      <view class="users-panel__head">
        <view class="users-panel__title">管理权益</view>
        <t-button
          t-class="users-panel__close"
          size="extra-small"
          variant="text"
          content="关闭"
          bind:tap="closePanel"
        />
      </view>

      <scroll-view
        class="users-panel__scroll"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        enable-flex
      >
        <view class="users-panel__profile">
          <t-avatar
            t-class="users-panel__avatar"
            image="{{user.avatarUrl}}"
            icon="user"
            size="120rpx"
            shape="circle"
            bind:error="onPanelAvatarError"
          />
          <view class="users-panel__meta">
            <view class="users-page__name">{{user.nickName || '未设置昵称'}}</view>
            <view class="users-page__id" bindtap="copyOpenid">{{user.openid}}</view>
            <view class="users-page__tags">
              <t-tag wx:if="{{user.entitlement.isVip}}" theme="warning" variant="light" size="small">包月中</t-tag>
              <t-tag wx:if="{{user.isAdmin}}" theme="danger" variant="light" size="small">管理员</t-tag>
              <t-tag theme="primary" variant="light" size="small">积分 {{user.entitlement.points}} 分</t-tag>
              <t-tag wx:if="{{user.entitlement.isVip}}" theme="success" variant="light" size="small">本月额度 {{user.entitlement.vipMonthQuota}} 分</t-tag>
              <t-tag theme="{{user.paidFen > 0 ? 'primary' : 'default'}}" variant="light" size="small">{{user.paidText}}</t-tag>
            </view>
          </view>
        </view>

        <view class="users-panel__block">
          <view class="users-panel__label-row">
            <text class="users-panel__label">包月</text>
            <text class="users-panel__hint">{{user.entitlement.isVip ? ('至 ' + user.entitlement.vipExpireText + ' · 本月剩余 ' + user.entitlement.vipMonthQuota + ' 分') : '未开通'}}</text>
          </view>
          <view class="users-page__row">
            <t-input
              class="users-page__input"
              borderless
              type="number"
              placeholder="续期天数"
              suffix="天"
              value="{{vipDays}}"
              bind:change="onVipDaysChange"
            />
            <t-button theme="warning" size="medium" content="开通/续期" bind:tap="onSetVipDays" />
          </view>
          <t-button
            wx:if="{{user.entitlement.isVip}}"
            class="users-page__cancel"
            theme="danger"
            variant="outline"
            size="medium"
            block
            content="取消包月"
            bind:tap="askCancelVip"
          />
        </view>

        <view class="users-panel__block">
          <view class="users-panel__label-row">
            <text class="users-panel__label">积分</text>
            <text class="users-panel__hint">静态 1 分 / 动态 2 分</text>
          </view>
          <view class="users-page__row">
            <t-input
              class="users-page__input"
              borderless
              type="number"
              suffix="分"
              value="{{pointsValue}}"
              bind:change="onPointsChange"
            />
            <t-button theme="primary" size="medium" content="设为" bind:tap="onSetPoints" />
          </view>
          <view class="users-page__row users-page__row--delta">
            <t-input
              class="users-page__input"
              borderless
              type="number"
              placeholder="自定义数量"
              suffix="分"
              value="{{pointsDelta}}"
              bind:change="onPointsDeltaChange"
            />
            <t-button
              t-class="users-page__delta-btn"
              theme="primary"
              variant="outline"
              size="medium"
              content="增加"
              bind:tap="onAddCustomPoints"
            />
            <t-button
              t-class="users-page__delta-btn"
              theme="danger"
              variant="outline"
              size="medium"
              content="扣除"
              bind:tap="onSubCustomPoints"
            />
          </view>
          <view class="users-page__adjust">
            <t-button t-class="users-page__adj-btn" size="small" variant="outline" content="+18 分" data-delta="18" bind:tap="onAdjustPoints" />
            <t-button t-class="users-page__adj-btn" size="small" variant="outline" content="+12 分" data-delta="12" bind:tap="onAdjustPoints" />
            <t-button t-class="users-page__adj-btn" size="small" variant="outline" content="+4 分" data-delta="4" bind:tap="onAdjustPoints" />
            <t-button t-class="users-page__adj-btn" size="small" variant="outline" content="+2 分" data-delta="2" bind:tap="onAdjustPoints" />
            <t-button t-class="users-page__adj-btn" size="small" variant="outline" theme="danger" content="清零" bind:tap="onClearPoints" />
          </view>
        </view>

        <view class="users-panel__block users-panel__block--logs">
          <t-collapse
            t-class="users-page__log-collapse"
            value="{{pointsLogsValue}}"
            expand-icon
            bind:change="onPointsLogsCollapse"
          >
            <t-collapse-panel
              t-class="users-page__log-panel"
              t-class-header="users-page__log-header"
              t-class-content="users-page__log-body"
              value="logs"
              header-right-content="{{pointsLogsLoading && !pointsLogs.length ? '加载中' : (pointsLogsTotal ? pointsLogsTotal + ' 条' : '')}}"
            >
              <view slot="header" class="users-panel__label">积分流水</view>
              <view class="users-panel__hint users-panel__hint--block">记录购买积分与包月额度变动；余额为可用总额</view>
              <view class="users-page__dl-state" wx:if="{{pointsLogsLoading && !pointsLogs.length}}">
                <t-loading theme="circular" size="40rpx" />
              </view>
              <fun-empty wx:elif="{{!pointsLogs.length}}" size="small" description="暂无积分流水" />
              <block wx:else>
                <t-cell-group t-class="users-page__log-group" bordered="{{false}}">
                  <t-cell
                    wx:for="{{pointsLogs}}"
                    wx:key="id"
                    t-class="users-page__log-cell"
                    t-class-title="users-page__log-title"
                    t-class-description="users-page__log-desc"
                    hover="{{false}}"
                    bordered="{{false}}"
                  >
                    <view slot="title" class="users-page__log-title">{{item.title}}</view>
                    <view slot="description" class="users-page__log-desc">{{item.createdText}}</view>
                    <view slot="note" class="users-page__log-right">
                      <text class="users-page__log-delta users-page__log-delta--{{item.tone}}">{{item.deltaText}}</text>
                      <text wx:if="{{item.balance != null}}" class="users-page__log-after">余 {{item.balance}}</text>
                    </view>
                  </t-cell>
                </t-cell-group>
                <t-button
                  wx:if="{{pointsLogsHasMore}}"
                  class="users-page__log-more"
                  theme="default"
                  variant="outline"
                  size="small"
                  block
                  loading="{{pointsLogsLoading}}"
                  content="加载更多"
                  bind:tap="onLoadMorePointsLogs"
                />
              </block>
            </t-collapse-panel>
          </t-collapse>
        </view>

        <view class="users-panel__block">
          <view class="users-panel__label">补发权益</view>
          <view class="users-panel__hint users-panel__hint--block">
            自动检查并补发：未到账的新用户见面礼、已中奖抽奖积分、已支付未发货的购买订单。
          </view>
          <t-button
            theme="success"
            variant="outline"
            size="medium"
            block
            icon="refresh"
            content="一键补发"
            loading="{{repairing}}"
            disabled="{{repairing || saving}}"
            bind:tap="askRepairEntitlements"
          />
        </view>

        <view class="users-panel__block users-panel__block--last">
          <view class="users-panel__label-row">
            <text class="users-panel__label">下载过的合集</text>
            <text class="users-panel__hint" wx:if="{{downloadsLoading}}">加载中…</text>
            <text class="users-panel__hint" wx:elif="{{downloadPacks.length}}">{{downloadPacks.length}} 个</text>
          </view>
          <view class="users-page__dl-state" wx:if="{{downloadsLoading && !downloadPacks.length}}">
            <t-loading theme="circular" size="40rpx" />
          </view>
          <fun-empty wx:elif="{{!downloadPacks.length}}" size="small" description="暂无下载记录" />
          <view wx:else class="users-page__dl-list">
            <view class="users-page__dl-card" wx:for="{{downloadPacks}}" wx:key="packId">
              <view
                class="users-page__dl-item"
                data-id="{{item.packId}}"
                bind:tap="onOpenPack"
              >
                <image
                  wx:if="{{item.coverUrl}}"
                  class="users-page__dl-cover"
                  src="{{item.coverUrl}}"
                  mode="aspectFill"
                />
                <view wx:else class="users-page__dl-cover users-page__dl-cover--empty">
                  <t-icon name="image" size="36rpx" />
                </view>
                <view class="users-page__dl-meta">
                  <text class="users-page__dl-title">{{item.title}}</text>
                  <text class="users-page__dl-sub">{{item.emojiCount}} 张 · 保存 {{item.count}} 次{{item.lastText ? ' · ' + item.lastText : ''}}</text>
                </view>
                <t-icon name="chevron-right" size="32rpx" />
              </view>
              <view wx:if="{{item.emojis.length}}" class="users-page__dl-emojis">
                <view
                  class="users-page__dl-emoji"
                  wx:for="{{item.emojis}}"
                  wx:for-item="em"
                  wx:key="label"
                  data-id="{{item.packId}}"
                  bind:tap="onOpenPack"
                >
                  <image
                    wx:if="{{em.thumbUrl}}"
                    class="users-page__dl-emoji-img"
                    src="{{em.thumbUrl}}"
                    mode="aspectFill"
                  />
                  <view wx:else class="users-page__dl-emoji-img users-page__dl-emoji-img--empty">
                    <t-icon name="image" size="28rpx" />
                  </view>
                  <text class="users-page__dl-emoji-label">{{em.label}}</text>
                  <text class="users-page__dl-emoji-count">×{{em.count}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </t-popup>

  <t-dialog
    visible="{{confirmVisible}}"
    title="{{confirmTitle}}"
    content="{{confirmContent}}"
    confirm-btn="确认"
    cancel-btn="取消"
    bind:confirm="onConfirm"
    bind:cancel="closeConfirm"
  />
  <lottery-host />
</view>
