<view class="users-page" style="{{themeStyle}}">
  <view class="users-page__tip">点选用户管理包月会员 / 积分。共 {{total}} 人，可筛选或搜索昵称、openid。</view>

  <view class="users-page__search-wrap">
    <t-search
      value="{{keyword}}"
      shape="round"
      placeholder="搜索昵称 / openid"
      clearable
      bind:change="onKeywordChange"
      bind:submit="onSearchSubmit"
      bind:clear="onSearchClear"
    />
  </view>

  <view class="users-page__filters">
    <t-check-tag
      size="medium"
      variant="dark"
      checked="{{filter === 'all'}}"
      content="全部"
      data-filter="all"
      bind:change="onFilterChange"
    />
    <t-check-tag
      size="medium"
      variant="dark"
      checked="{{filter === 'vip'}}"
      content="包月"
      data-filter="vip"
      bind:change="onFilterChange"
    />
    <t-check-tag
      size="medium"
      variant="dark"
      checked="{{filter === 'points'}}"
      content="有积分"
      data-filter="points"
      bind:change="onFilterChange"
    />
  </view>

  <view class="users-page__state" wx:if="{{listLoading && !list.length}}">
    <t-loading theme="circular" size="48rpx" text="加载中" />
  </view>

  <block wx:elif="{{list.length}}">
    <view
      class="users-page__item"
      wx:for="{{list}}"
      wx:key="openid"
      data-index="{{index}}"
      bindtap="onSelectUser"
    >
      <t-avatar
        t-class="users-page__avatar"
        image="{{item.avatarUrl}}"
        icon="user"
        size="88rpx"
        shape="circle"
      />
      <view class="users-page__meta">
        <view class="users-page__name-row">
          <text class="users-page__name">{{item.nickName || '未设置昵称'}}</text>
          <t-tag wx:if="{{item.isAdmin}}" size="small" theme="danger" variant="light">管理员</t-tag>
          <t-tag wx:if="{{item.entitlement.isVip}}" size="small" theme="warning" variant="light">包月</t-tag>
        </view>
        <view class="users-page__sub">{{item.statusText}} · 积分 {{item.entitlement.points}}{{item.entitlement.isVip ? ' · 本月 ' + item.entitlement.vipMonthQuota : ''}}</view>
        <view class="users-page__sub">{{item.shortId}}{{item.lastLoginText ? ' · ' + item.lastLoginText : ''}}</view>
      </view>
      <t-icon name="chevron-right" size="36rpx" />
    </view>
    <view class="users-page__footer">
      {{listHasMore ? (listLoading ? '加载中...' : '上拉加载更多') : '没有更多了'}}
    </view>
  </block>

  <view class="users-page__state" wx:else>
    <t-empty description="暂无用户" />
  </view>

  <t-popup visible="{{panelVisible}}" placement="bottom" bind:visible-change="onPopupChange">
    <view class="users-panel" wx:if="{{user}}">
      <view class="users-panel__head">
        <view class="users-panel__title">管理权益</view>
        <t-button size="extra-small" variant="text" content="关闭" bind:tap="closePanel" />
      </view>

      <view class="users-panel__profile">
        <t-avatar
          t-class="users-page__avatar"
          image="{{user.avatarUrl}}"
          icon="user"
          size="88rpx"
          shape="circle"
        />
        <view class="users-page__meta">
          <view class="users-page__name">{{user.nickName || '未设置昵称'}}</view>
          <view class="users-page__id" bindtap="copyOpenid">{{user.openid}}</view>
          <view class="users-page__tags">
            <t-tag wx:if="{{user.entitlement.isVip}}" theme="warning" variant="light" size="small">包月</t-tag>
            <t-tag wx:if="{{user.isAdmin}}" theme="danger" variant="light" size="small">管理员</t-tag>
            <t-tag theme="primary" variant="light" size="small">积分 {{user.entitlement.points}}</t-tag>
            <t-tag wx:if="{{user.entitlement.isVip}}" theme="success" variant="light" size="small">本月 {{user.entitlement.vipMonthQuota}}</t-tag>
          </view>
        </view>
      </view>

      <view class="users-panel__block">
        <view class="users-panel__label">包月 · {{user.entitlement.isVip ? ('至 ' + user.entitlement.vipExpireText + ' · 本月剩余 ' + user.entitlement.vipMonthQuota) : '未开通'}}</view>
        <view class="users-page__row">
          <t-input
            class="users-page__input"
            borderless
            type="number"
            placeholder="天数"
            value="{{vipDays}}"
            bind:change="onVipDaysChange"
          />
          <t-button theme="warning" size="medium" content="开通/续期" bind:tap="onSetVipDays" />
        </view>
        <t-button
          wx:if="{{user.entitlement.isVip}}"
          class="users-page__cancel"
          theme="danger"
          variant="outline"
          size="medium"
          block
          content="取消包月"
          bind:tap="askCancelVip"
        />
      </view>

      <view class="users-panel__block">
        <view class="users-panel__label">积分（静态 1 积分 / 动态 2 积分）</view>
        <view class="users-page__row">
          <t-input
            class="users-page__input"
            borderless
            type="number"
            value="{{pointsValue}}"
            bind:change="onPointsChange"
          />
          <t-button theme="primary" size="medium" content="设为" bind:tap="onSetPoints" />
        </view>
        <view class="users-page__adjust">
          <t-button size="small" variant="outline" content="+20" data-delta="20" bind:tap="onAdjustPoints" />
          <t-button size="small" variant="outline" content="+10" data-delta="10" bind:tap="onAdjustPoints" />
          <t-button size="small" variant="outline" content="-1" data-delta="-1" bind:tap="onAdjustPoints" />
          <t-button size="small" variant="outline" theme="danger" content="-10" data-delta="-10" bind:tap="onAdjustPoints" />
          <t-button size="small" variant="outline" theme="danger" content="清零" bind:tap="onClearPoints" />
        </view>
      </view>
    </view>
  </t-popup>

  <t-dialog
    visible="{{confirmVisible}}"
    title="{{confirmTitle}}"
    confirm-btn="确认"
    cancel-btn="取消"
    bind:confirm="onConfirm"
    bind:cancel="closeConfirm"
  />
</view>
