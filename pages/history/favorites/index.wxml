<page-meta page-style="{{themeStyle}}" />
<view class="favorites" style="{{themeStyle}}">
  <view class="favorites__bar">
    <view class="favorites__bar-count">
      <kubai-icon name="heart" size="32rpx" color="#EB5757" />
      <text>{{list.length ? list.length + ' 个合集' : '我的收藏'}}</text>
    </view>
  </view>

  <view
    wx:if="{{showNativeAd && nativeAdUnitId}}"
    class="favorites__native-ad"
  >
    <ad-custom
      unit-id="{{nativeAdUnitId}}"
      binderror="onNativeAdError"
    />
  </view>

  <view wx:if="{{loading && !list.length}}" class="favorites__state">
    <t-loading theme="circular" size="40rpx" text="加载中" />
  </view>

  <block wx:elif="{{!list.length}}">
    <view class="favorites__empty">
      <fun-empty fill description="还没有收藏合集" />
      <t-button
        theme="primary"
        size="medium"
        content="去首页看看"
        bind:tap="goHome"
      />
    </view>
  </block>

  <view wx:else class="favorites__feed" style="gap: {{rowGap}}px;">
    <view
      class="favorites__pack-row"
      wx:for="{{list}}"
      wx:key="packId"
      data-id="{{item.packId}}"
      bindtap="onOpenPack"
      hover-class="favorites__pack-row--press"
      hover-start-time="20"
      hover-stay-time="80"
    >
      <view class="favorites__pack-row-head">
        <text class="favorites__pack-row-title">{{item.title}}</text>
        <view
          class="favorites__pack-row-heart"
          data-id="{{item.packId}}"
          catchtap="onUnfavorite"
          aria-role="button"
          aria-label="取消收藏"
        >
          <kubai-icon name="heart-filled" size="36rpx" color="#EB5757" />
        </view>
      </view>

      <view
        wx:if="{{item.previewSlots && item.previewSlots.length}}"
        class="favorites__pack-row-grid"
        style="grid-template-columns: repeat({{previewRowCount}}, 1fr);"
      >
        <view
          class="favorites__pack-row-cell"
          wx:for="{{item.previewSlots}}"
          wx:for-item="slot"
          wx:key="key"
        >
          <smart-image
            src="{{slot.url}}"
            file-id="{{slot.fileID}}"
            cache-key="{{slot.cacheKey}}"
            mode="aspectFill"
            shape="round"
            lazy
            radius="14rpx"
            transparent
          />
          <view
            wx:if="{{slot.showMore && item.moreCount > 0}}"
            class="favorites__pack-row-moremask"
          >+{{item.moreCount}}</view>
        </view>
      </view>
      <view wx:else class="favorites__pack-row-cover-wrap">
        <image
          class="favorites__pack-row-cover"
          src="{{item.coverUrl}}"
          mode="aspectFill"
          lazy-load
        />
      </view>

      <view class="favorites__pack-row-foot">
        <view class="favorites__pack-row-tags">
          <t-tag
            wx:if="{{item.categoryName}}"
            size="small"
            theme="default"
            variant="light"
            custom-style="{{item.categoryTagStyle}}"
          >{{item.categoryName}}</t-tag>
          <text wx:if="{{item.createdText}}" class="favorites__pack-row-time">收藏于 {{item.createdText}}</text>
        </view>
        <text wx:if="{{isAdmin}}" class="favorites__pack-row-meta">下载 {{item.downloadCount || 0}}</text>
        <text wx:elif="{{item.itemCountText}}" class="favorites__pack-row-meta">{{item.itemCountText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="favorites__more">
    <t-loading theme="circular" size="32rpx" text="加载更多" />
  </view>
  <view wx:elif="{{list.length && !hasMore}}" class="favorites__end">没有更多了</view>

  <lottery-host />
  <heart-burst id="heartBurst" />
</view>
